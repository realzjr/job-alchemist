"};</script>
</head>
<body>

<div id="loadingOverlay">
  <img class="ld-icon" src="data:image/webp;base64," alt="咸鱼" onerror="this.outerHTML='<div class=\'ld-icon\'>🐟</div>'">
  <div class="ld-title">工位炼金师</div>
  <div class="ld-dots"><i></i><i></i><i></i></div>
  <div class="ld-text" id="ldText">完蛋！我被岗位包围了！</div>
</div>
<script>
// 加载画面文案轮换（hideLoading 里会清掉这个定时器）
(function(){
  var lines=['完蛋！我被岗位包围了！','OFFER正在审批中……','入职手续办理中……'];
  var i=0,el=document.getElementById('ldText');
  if(!el)return;
  window._ldTimer=setInterval(function(){
    i=(i+1)%lines.length;
    el.style.opacity=0;
    setTimeout(function(){el.textContent=lines[i];el.style.opacity=1},200);
  },3000);
})();
</script>

<div id="ticker"><span id="tickerText"></span></div>

<div class="room-area">
  <div class="room-nav">
    <button class="arrow-btn" id="btnPrev" onclick="prevRoom()">←</button>
    <div class="room-title-area" onclick="openMap()" style="cursor:pointer">
      <div class="room-title" id="roomTitle"></div>
      <div class="room-desc" id="roomDesc"></div>
      <div class="room-dots" id="roomDots"></div>
    </div>
    <button class="arrow-btn" id="btnNext" onclick="nextRoom()">→</button>
  </div>
  <div class="room-container" id="roomContainer"></div>
</div>

<div class="craft-area">
  <div class="craft-main">
    <div class="craft-row">
      <div class="c-slot" id="cs0" onclick="removeCraftSlot(0)"><span class="cs-num">①</span></div>
      <span class="c-plus">+</span>
      <div class="c-slot" id="cs1" onclick="removeCraftSlot(1)"><span class="cs-num">②</span></div>
    </div>
    <button class="craft-btn" id="craftBtn" onclick="doCraft()" disabled>合成!</button>
    <button class="small-btn clear-btn" onclick="clearCraft()">清空</button>
  </div>
  <div class="side-bar">
    <button class="side-btn" onclick="showHint()">💡<span>提示</span></button>
    <button class="side-btn" onclick="openCodex()">📖<span>图鉴</span></button>
    <button class="side-btn tut-hide" onclick="openMap()">🗺️<span>地图</span></button>
    <button class="side-btn tut-hide" onclick="openSettings()">⚙️<span>设置</span></button>
  </div>
</div>

<div class="overlay" id="codexOverlay" onclick="closeOverlay(event)">
  <div class="codex-popup" onclick="event.stopPropagation()">
    <div class="codex-popup-header">
      <h2>📖 图鉴</h2>
      <button class="codex-popup-close" onclick="closeCodex()">✕</button>
    </div>
    <div class="codex-tabs" id="codexTabs"></div>
    <div class="codex-grid" id="codexGrid"></div>
  </div>
</div>

<div class="overlay" id="mapOverlay" onclick="closeOverlay(event)">
  <div class="map-popup map-float" onclick="event.stopPropagation()">
    <div class="map-head">
      <h2>选择你想要去的工区</h2>
      <button class="codex-popup-close" onclick="closeMap()">✕</button>
    </div>
    <div class="map-stage"><div class="map-track" id="mapTrack"></div></div>
    <div class="map-legend">← 滑动选择 · 点击居中的工区前往 →</div>
  </div>
</div>

<div class="overlay" id="recipeOverlay" onclick="closeOverlay(event)"><div class="popup" id="recipeCard" onclick="event.stopPropagation()" style="text-align:left;max-height:85vh;overflow-y:auto"></div></div>

<div class="overlay" id="settingsOverlay" onclick="closeOverlay(event)">
  <div class="popup" onclick="event.stopPropagation()" style="text-align:left;position:relative">
    <button class="set-close" onclick="document.getElementById('settingsOverlay').classList.remove('show')">✕</button>
    <div style="text-align:center;font-size:1.15em;font-weight:700;margin-bottom:4px">⚙️ 设置</div>
    <div class="set-sec">声音</div>
    <div class="set-row"><span>🎵 背景音乐</span><div class="sw" id="bgmToggle" onclick="toggleBgm()"><div class="sw-knob"></div></div></div>
    <div class="set-row" style="border-bottom:none"><span>🔊 音量</span><input type="range" id="bgmVol" min="0" max="100" value="50" oninput="setBgmVol(this.value)"></div>
    <div class="set-sec">更多</div>
    <div class="set-grid">
      <button class="set-tile" onclick="sharePoster()"><span class="st-ico">📤</span>分享游戏</button>
      <button class="set-tile" onclick="likeAuthor()"><span class="st-ico">🌸</span>喜欢作者</button>
      <button class="set-tile" onclick="showHelp()"><span class="st-ico">❓</span>获取帮助</button>
      <button class="set-tile" onclick="location.href='mailto:3150641163@qq.com?subject=工位炼金师bug反馈'"><span class="st-ico">🐞</span>反馈bug</button>
      <button class="set-tile" onclick="replayTutorial()"><span class="st-ico">📺</span>重看教程</button>
      <button class="set-tile" onclick="resetAll()"><span class="st-ico">🔄</span>重新开始</button>
    </div>
    <button class="set-wide" onclick="goApply()">📮 我做好准备投简历了！</button>
  </div>
</div>
<!-- 海报弹窗必须放在 settingsOverlay 之后：z-index 相同（500）时后画的盖先画的，否则从设置里点分享，海报会被设置弹窗压在下面 -->
<div class="overlay" id="posterOverlay" onclick="closeOverlay(event)">
  <div class="popup" onclick="event.stopPropagation()" style="text-align:center;max-height:92%;overflow-y:auto">
    <div id="posterBox"></div>
    <div style="font-size:.72em;color:#8a7452;margin-top:8px">长按或右键保存图片，分享给朋友吧</div>
  </div>
</div>
<div class="overlay" id="resultOverlay" onclick="closeOverlay(event)"><div class="popup" id="resultCard"></div></div>
<div class="overlay" id="detailOverlay" onclick="closeOverlay(event)"><div class="popup" id="detailCard"></div></div>
<input type="file" id="upInput" accept="image/*" style="display:none" onchange="if(this.files[0])_doUpload(this.files[0]);this.value=''">
<div class="toast" id="toast"></div>

<script>
// ============================================================
// 岗位合成器 - 内容数据文件（由 剧情表.xlsx + 剧情/*.json 生成）
// 物品名以 assets/items/ 下的图片文件名为准（物品id即物品名）
// 替换游戏要素只需要改这个文件，index.html 是引擎，不用动。
// 改完自查：浏览器打开 index.html?debug=1 看数据校验报告；
// 摆放道具位置：打开 index.html?edit=1 直接拖动道具，再点"保存/发布"。
// 详细说明见 CONTENT_GUIDE.md
// ============================================================
window.GAME_DATA={

// 存档版本号：整套换内容时必须改，玩家旧存档会自动作废
version:'v24',

// ---------- 图片图标开关 ----------
// useImages 为 true 时按以下约定自动加载图片，缺图的自动显示 emoji：
//   assets/items/<物品名>.png   assets/jobs/<岗位名>.png   assets/rooms/<房间id>.png
useImages:true,
assetBase:'assets/',


// ---------- 房间 ----------

// unlockAt: 需要合成多少个岗位才解锁(0=默认开放)，按表格的第1~5房间顺序递进

rooms:[{"id":"front","name":"玄门·Landing Zone","emoji":"🛎️","unlockAt":0,"scene":"front","entrance":true,"desc":"对投资人和快递员一视同仁的公司门面"},{"id":"admin","name":"中柱·Supporting Platform","emoji":"📋","unlockAt":2,"unlockText":"合成2个岗位解锁","scene":"admin","desc":"表格、票据、印章在这里昼夜不停流转"},{"id":"lab","name":"星月·Generating Lab","emoji":"🔬","unlockAt":6,"unlockText":"合成6个岗位解锁","scene":"lab","desc":"咖啡和bug在这里经过月光催化发生反应"},{"id":"market","name":"阳雪·Curating Arena","emoji":"📣","unlockAt":16,"unlockText":"合成16个岗位解锁","scene":"market","desc":"创作灵感和增长机遇一样可遇不可求"},{"id":"boss","name":"富贵·Directing Sanctum","emoji":"🚪","unlockAt":30,"unlockText":"合成30个岗位解锁","scene":"boss","desc":"安保最森严但经常没人在的神秘之所","extras":"<div class=\"f boss-man\"></div>","bossMan":{"x":61.2,"y":37,"w":11.1,"h":40}}],


// ---------- 公司平面图布局 ----------

mapLayout:[['lab','market'],['admin','boss'],['front']],


// ---------- 基础道具 ----------

// 位置是自动网格排布的，用 ?edit=1 拖到理想位置再保存

baseItems:[{"id":"发财树","name":"发财树","desc":"老板最上心的老员工","room":"front","x":-21.1,"y":56.7,"w":207,"h":207},{"id":"咸鱼","name":"咸鱼","desc":"哪个新入职员工被打回原形了？","room":"front","x":63,"y":90.6,"w":50,"h":50},{"id":"钥匙","name":"钥匙","desc":"拿它的不一定是老板，也可能是保安","room":"front","x":54,"y":46.4,"w":16,"h":16},{"id":"拖把","name":"拖把","desc":"嘻唰唰，嘻唰唰，拖走霉运","room":"front","x":85.8,"y":60.9,"w":90,"h":90},{"id":"招财猫","name":"招财猫","desc":"猫毛过敏也可以养的小猫","room":"front","x":37.8,"y":49.6,"w":45,"h":45},{"id":"外卖","name":"外卖","desc":"谁的拼好饭到了？","room":"front","x":21.4,"y":76.2,"w":54,"h":54},{"id":"电话","name":"电话","desc":"响起的瞬间，全办公室都希望它找的不是自己","room":"front","x":74.5,"y":56.5,"w":34,"h":34},{"id":"快递","name":"快递","desc":"写着CEO签收，可能是锦旗，也可能是牛粪","room":"front","x":41,"y":78.5,"w":72,"h":72},{"id":"门禁卡","name":"门禁卡","desc":"工本费50，丢失需要再次缴纳","room":"front","x":74.6,"y":42.3,"w":57,"h":57},{"id":"水杯","name":"水杯","desc":"工位喝水也能喝出中产感","room":"admin","x":79,"y":71.2,"w":38,"h":38},{"id":"简历","name":"简历","desc":"其中99%会进公司人才库","room":"admin","x":59.9,"y":69.5,"w":37,"h":37},{"id":"公章","name":"公章","desc":"全公司最难请出的员工","room":"admin","x":66.1,"y":75.6,"w":21,"h":21},{"id":"剪刀","name":"剪刀","desc":"一刀剪断人情冷暖，两刀剪不断职场关系","room":"admin","x":26.9,"y":65.8,"w":25,"h":25},{"id":"报销单","name":"报销单","desc":"所有员工填得最认真的文件","room":"admin","x":57.2,"y":66.9,"w":26,"h":26},{"id":"垃圾桶","name":"垃圾桶","desc":"办公室人人必争的战略物资","room":"admin","x":86.4,"y":89.4,"w":47,"h":47},{"id":"打印机","name":"打印机","desc":"全公司的劳模，卡纸时除外","room":"admin","x":27.1,"y":60.2,"w":34,"h":34},{"id":"放大镜","name":"放大镜","desc":"“让我来找一找哪一个项目是你独立完成的”","room":"admin","x":73.8,"y":71,"w":17,"h":17},{"id":"算盘","name":"算盘","desc":"老财务的包浆情怀，写着珠算班专用","room":"admin","x":64,"y":46.9,"w":43,"h":43},{"id":"锅","name":"锅","desc":"怎么会有一口锅在办公室","room":"admin","x":45.1,"y":67.8,"w":43,"h":43},{"id":"饮水机","name":"饮水机","desc":"公司八卦浓度最高的三平米","room":"admin","x":-20.7,"y":61.9,"w":190,"h":190},{"id":"小虫","name":"小虫","desc":"不是bug，是特性；不是特性，那就是历史遗留","room":"lab","x":8.9,"y":52.6,"w":15,"h":15},{"id":"便签","name":"便签","desc":"每一条todo，都是一场行为艺术","room":"lab","x":22.7,"y":72.3,"w":21,"h":21},{"id":"制冰机","name":"制冰机","desc":"选择冰水厂是一种生活态度","room":"lab","x":72.3,"y":71,"w":150,"h":150},{"id":"咖啡机","name":"咖啡机","desc":"打工人专属98号汽油，公司免费提供","room":"lab","x":88,"y":51.7,"w":29,"h":29},{"id":"无人机","name":"无人机","desc":"研发小哥的航拍玩具，下班才能起飞","room":"lab","x":45.1,"y":22,"w":45,"h":45},{"id":"泡面","name":"泡面","desc":"最受欢迎的深夜食堂，来自自费售货机","room":"lab","x":38.8,"y":62.4,"w":29,"h":29},{"id":"耳机","name":"耳机","desc":"一键让同事轻轻地来，轻轻地走","room":"lab","x":95.9,"y":61.7,"w":21,"h":21},{"id":"顶配机","name":"顶配机","desc":"Ultra9+5090+128G满血","room":"lab","x":78.9,"y":54.9,"w":56,"h":56},{"id":"海报","name":"海报","desc":"公司第一篇百万爆款","room":"market","x":32.2,"y":32.1,"w":87,"h":87},{"id":"台灯","name":"台灯","desc":"你见过凌晨四点的办公室吗？","room":"market","x":22.4,"y":54.2,"w":56,"h":56},{"id":"饼","name":"饼","desc":"老板不会拿员工的奖金开玩笑的","room":"market","x":29,"y":85.9,"w":57,"h":57},{"id":"木马","name":"木马","desc":"公司里唯一不用吃饭的马","room":"market","x":55.4,"y":74.3,"w":94,"h":94},{"id":"珍珠奶茶","name":"珍珠奶茶","desc":"千宝免费请大家喝秋天的第一杯奶茶了","room":"market","x":82.4,"y":66.7,"w":29,"h":29},{"id":"转盘","name":"转盘","desc":"年会物资，一等奖是和老板共进晚餐","room":"market","x":81.6,"y":92.9,"w":45,"h":45},{"id":"毛绒玩具","name":"毛绒玩具","desc":"准备送客户的公款果冻猫","room":"market","x":22.6,"y":72.1,"w":48,"h":48},{"id":"麦克风","name":"麦克风","desc":"据说是老板路演时用的幸运麦","room":"market","x":57.6,"y":61.5,"w":25,"h":25},{"id":"名贵红酒","name":"名贵红酒","desc":"这是老板从哪个剧组借来的演员？","room":"boss","x":17.2,"y":62.9,"w":19,"h":19},{"id":"保险柜","name":"保险柜","desc":"毛重五十斤，净重五十斤","room":"boss","x":51.9,"y":66.4,"w":43,"h":43},{"id":"山水画","name":"山水画","desc":"老板给这幅画叫《人生是旷野》","room":"boss","x":42.6,"y":17.2,"w":118,"h":118},{"id":"精品茶叶","name":"精品茶叶","desc":"小罐明前龙井，专为大客户制作","room":"boss","x":42.1,"y":64.4,"w":20,"h":20},{"id":"红木家具","name":"红木家具","desc":"闻起来有一种经济上行期的味道","room":"boss","x":60.8,"y":52.3,"w":196,"h":196},{"id":"罗盘","name":"罗盘","desc":"19年购入的纯金罗盘，公司最赚的一笔投资","room":"boss","x":35.7,"y":68.2,"w":18,"h":18},{"id":"鱼竿","name":"鱼竿","desc":"醉翁之意不在酒，渔翁之意不在鱼","room":"boss","x":-9.6,"y":68.8,"w":91,"h":91}],


// ---------- 物品合成配方 ----------

itemRecipes:[{"a":"电话","b":"饮水机","result":"瓜","name":"瓜","desc":"好大的瓜！不过究竟是谁的瓜！","room":"front","x":72.6,"y":77.9,"w":83,"h":83},{"a":"垃圾桶","b":"门禁卡","result":"水桶","name":"水桶","desc":"打工人的家当，非常便携","room":"front","x":91.1,"y":76,"w":62,"h":62},{"a":"快递","b":"公章","result":"节日福利","name":"节日福利","desc":"员工福盒，包装大概率比内容用心","room":"admin","x":56.1,"y":90.7,"w":47,"h":47},{"a":"招财猫","b":"保险柜","result":"貔貅","name":"貔貅","desc":"老板说这是貔貅，那这就是貔貅","room":"boss","x":9.2,"y":64,"w":24,"h":24},{"a":"咖啡机","b":"制冰机","result":"冰美式","name":"冰美式","desc":"凌晨三点下单的冰美式，并非没事","room":"lab","x":73,"y":64.7,"w":21,"h":21},{"a":"麦克风","b":"咸鱼","result":"电子木鱼","name":"电子木鱼","desc":"仿生唐僧会梦里会敲电子木鱼吗","room":"market","x":37.9,"y":77.9,"w":32,"h":32},{"a":"珍珠奶茶","b":"台灯","result":"灵感","name":"灵感","desc":"深夜和奶茶是赶ddl的第一生产力","room":"market","x":44.1,"y":55.2,"w":33,"h":33},{"a":"山水画","b":"罗盘","result":"地球仪","name":"地球仪","desc":"眼观全球，脚踩淤泥","room":"boss","x":8.9,"y":50.7,"w":24,"h":24},{"a":"鱼竿","b":"发财树","result":"接offer大楼","name":"接offer大楼","desc":"谁不想一竿钓到SSP大结果","room":"boss","x":51.4,"y":47.9,"w":62,"h":62}],


