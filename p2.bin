easterEggs:[["保险柜","锅","违禁电器当然得藏起来！","🍲"],["小虫","饼","你的Agent给你画了个饼，但饼里都是bug","🐛"],["名贵红酒","泡面","红酒是生活态度，泡面是工作精神","🍜"],["锅","饼","背锅配大饼，打工人标配午餐","🍳"],["公章","瓜","公司内部的瓜，吃得更香了","🍉"],["水桶","公章","拿着公章提桶跑路？你是要上市还是要上山","🪣"],["冰美式","名贵红酒","被你发现了隐藏早c晚a爆款，冰红酒美式……","🍷"],["招财猫","貔貅","在工位上猫狗双全，打工人的究极梦想","🐱"],["饼","地球仪","老板说我们要拓宽全球市场","🌍"],["垃圾桶","简历","垃圾桶是公司最大的人才库","🗑️"],["珍珠奶茶","红木家具","总裁私下里的小爱好，4元撑起的青春回忆……","🧋"],["外卖","保险柜","再也不怕外卖被顺走了……","🥡"],["钥匙","保险柜","把钥匙锁进保险柜里了？你自求多福吧","🔑"],["红木家具","泡面","老板说吃泡面也是一种老钱风！","🪑"],["鱼竿","咸鱼","愿者上钩，老板就是招我来摸鱼的！","🎣"],["泡面","台灯","热水用完只能靠台灯加热泡面了……","💡"],["垃圾桶","公章","私自销毁公章？刑，很刑！","⚖️"],["剪刀","简历","喂！住手！再没人入职公司就要倒闭了！","✂️"],["报销单","垃圾桶","等一下！那张报销单还没投呢！扔了和你没完！","🧾"],["打印机","珍珠奶茶","打印奶茶止馋，办公室里的减肥小妙招","🖨️"],["转盘","公章","CEO轮流做，今年到谁家？","🎡"],["麦克风","拖把","保洁阿姨也有一个好声音梦","🎤"],["精品茶叶","泡面","拿龙井泡面？恭喜成为杭州美食必吃榜！","🍵"],["快递","保险柜","邮寄的是公司机密，守住的是你的工卡","📦"],["门禁卡","公章","什么？你想把公章带出公司？已经发给阳光职场","🪪"],["发财树","饮水机","老板说发财树只能用依云浇，你完蛋了","🌳"],["外卖","公章","公司定点外卖餐厅，盒饭八十一份","🍱"],["小虫","外卖","你的外卖被同事电脑里的bug吃了，我是说真的","🐞"],["制冰机","泡面","冷面都这么冷了，热量肯定是负数吧","🧊"],["接offer大楼","海报","床头贴一张这个，做一个拿offer的美梦","🏢"],["门禁卡","转盘","随机抽取一个人打卡打不上，恭喜抽到迟到10分钟","⏰"],["放大镜","饼","放大了看，这不仅是张饼，还全是心眼","🔍"],["海报","算盘","海报排期已经满到得靠算盘算了","🧮"],["算盘","门禁卡","补卡费用刚好卡在一顿饭的价格","💸"],["便签","饼","每一个需求都是一张新画的大饼","📝"],["放大镜","瓜","这瓜只能和你讲这么多了，再看也看不出什么","🕵️"]],


