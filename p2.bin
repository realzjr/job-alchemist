</script>
<script>
// ==================== ENGINE ====================
// 游戏内容全部在 data.js（GAME_DATA）中定义，本文件只负责逻辑与渲染。
// ?edit=1 布局编辑模式（拖动道具+导出坐标）  ?debug=1 数据校验报告  ?preview=1 房间全解锁（编辑版预览正式版用）
const D=window.GAME_DATA||{};
const Q=new URLSearchParams(location.search);
const EDIT=Q.has('edit'),DEBUG=Q.has('debug'),PREVIEW=Q.has('preview');
const ROOMS=D.rooms||[];
const BASE_ITEMS=D.baseItems||[];
const ITEM_RECIPES=D.itemRecipes||[];
const JOB_RECIPES=D.jobRecipes||[];
let SYNTH_ITEMS,ALL_ITEMS,itemMap,itemRecipeLookup,jobRecipeLookup,TOTAL;
function rebuildDerived(){
  SYNTH_ITEMS=ITEM_RECIPES.map(r=>({id:r.result,emoji:r.emoji,name:r.name,room:r.room,isSynth:true,x:r.x,y:r.y,w:r.w,h:r.h}));
  ALL_ITEMS=[...BASE_ITEMS,...SYNTH_ITEMS];
  itemMap={};ALL_ITEMS.forEach(i=>itemMap[i.id]=i);
  itemRecipeLookup={};ITEM_RECIPES.forEach(r=>{const k=[r.a,r.b].sort().join('+');r.key=k;itemRecipeLookup[k]=r});
  jobRecipeLookup={};JOB_RECIPES.forEach(r=>{r.key=[r.a,r.b].sort().join('+');jobRecipeLookup[r.key]=r});
  TOTAL=ITEM_RECIPES.length+JOB_RECIPES.length;
}
rebuildDerived();
const EASTER_EGGS={};
const EGGS=[];
(D.easterEggs||[]).forEach(([a,b,msg,emoji])=>{const k=[a,b].sort().join('+');const eg={a,b,msg,emoji:emoji||'🥚',key:k};EASTER_EGGS[k]=eg;EGGS.push(eg)});
const GENERIC_FAILS=(D.genericFails&&D.genericFails.length)?D.genericFails:['合成失败，换个组合试试。'];
const HINT_TEXTS=(D.hintTexts&&D.hintTexts.length)?D.hintTexts:[];
// 失败语/提示语里的【A】【B】占位符替换成物品名
function fillAB(t,a,b){return t.split('【A】').join(a).split('【B】').join(b)}
const ROOM_DECOS=D.roomDecos||{};
const SAVE_KEY='jc_'+(D.version||'v1');
// 图片图标：useImages 开启后按约定路径找图，加载失败自动回退 emoji
// 约定：assets/items/<道具id>.webp  assets/jobs/<岗位名>.webp  assets/rooms/<房间id>.webp  assets/rooms/<房间id>_bg.webp(场景背景)
// 单条数据可用 img:'路径' 覆盖约定文件名
let USE_IMG=!!D.useImages;let _imgVer=+(localStorage.getItem('jc_imgver')||0);
const ASSET_BASE=D.assetBase||'assets/';
// 资源 URL 统一入口：单文件打包版（pack_mobile.py 注入 __INLINE_ASSETS）直接给 dataURL，否则走 assets/ 目录
function assetURL(p){
  const M=window.__INLINE_ASSETS;
  if(M&&M[p])return M[p];
  return ASSET_BASE+encodeURI(p)+(_imgVer?'?v='+_imgVer:'');
}
function iconHTML(emoji,path){
  if(!emoji)emoji='❔'; // 数据缺 emoji 时兜底，避免把 undefined 渲染到页面上
  if(!USE_IMG||!path)return emoji;
  if(IMG_OK[path]===false)return emoji; // 预探测已确认无图，直接渲染字形，避免破图占位闪烁
  return `<span class="ico"><img src="${assetURL(path)}" onerror="this.parentNode.classList.add('noimg')" draggable="false"><em>${emoji}</em></span>`;
}
// 图片存在性预探测：启动时一次性探完。img 的 onerror 触发时机不可靠（缓存/串行服务器），
// 依赖它会在破图占位与字形之间反复横跳，导致图标尺寸每次渲染都不一样。
const IMG_OK={};
function probeImages(){
  const paths=new Set();
  ALL_ITEMS.forEach(i=>paths.add(i.img||('items/'+i.id+'.webp')));
  JOB_RECIPES.forEach(j=>paths.add(j.img||('jobs/'+j.job+'.webp')));
  ROOMS.forEach(r=>paths.add(r.img||('rooms/'+r.id+'.webp')));
  return Promise.all([...paths].map(p=>new Promise(res=>{
    if(p in IMG_OK)return res();
    const im=new Image();
    // 慢网兜底：4秒没探到就放行渲染（不落缓存），乐观输出 <img>，图加载慢也能随后显示；
    // 否则任何一张图挂起都会让整个游戏白屏
    const to=setTimeout(()=>res(),4000);
    im.onload=()=>{clearTimeout(to);IMG_OK[p]=true;res()};
    im.onerror=()=>{clearTimeout(to);IMG_OK[p]=false;res()};
    im.src=assetURL(p);
  })));
}
const itemIcon=it=>iconHTML(it.emoji,it.img||('items/'+it.id+'.webp'));
const jobIcon=j=>iconHTML(j.emoji,j.img||('jobs/'+j.job+'.webp'));
const roomIcon=r=>iconHTML(r.emoji,r.img||('rooms/'+r.id+'.webp'));

// ==================== STATE ====================
let S={currentRoom:0,revealed:[],discoveredItems:[],discoveredJobs:[],discoveredEggs:[],slots:[null,null],codexFilter:'base',bossReady:false,bossMet:false};
function load(){try{const d=JSON.parse(localStorage.getItem(SAVE_KEY));if(d){S.revealed=d.revealed||[];S.discoveredItems=d.discoveredItems||[];S.discoveredJobs=d.discoveredJobs||[];S.discoveredEggs=d.discoveredEggs||[];S.bossReady=!!d.bossReady;S.bossMet=!!d.bossMet;S.tutorialDone=!!d.tutorialDone}}catch(e){}}
function save(){localStorage.setItem(SAVE_KEY,JSON.stringify({revealed:S.revealed,discoveredItems:S.discoveredItems,discoveredJobs:S.discoveredJobs,discoveredEggs:S.discoveredEggs,bossReady:S.bossReady,bossMet:S.bossMet,tutorialDone:S.tutorialDone}));try{NET.syncSoon()}catch(e){}}

// ==================== HELPERS ====================
function jobCount(){return S.discoveredJobs.length}
function unlockedItemCount(){return S.revealed.length+S.discoveredItems.length}
function isUnlocked(room){return EDIT||PREVIEW||jobCount()>=room.unlockAt}
function isRevealed(id){return S.revealed.includes(id)}
function isSynthOwned(id){return ITEM_RECIPES.some(r=>r.result===id&&S.discoveredItems.includes(r.key))}
function canUseItem(id){const it=itemMap[id];if(!it)return false;if(it.isSynth)return isSynthOwned(id);return isRevealed(id)}
function getRoomItems(roomId){
  const base=BASE_ITEMS.filter(i=>i.room===roomId);
  const synth=SYNTH_ITEMS.filter(i=>i.room===roomId&&isSynthOwned(i.id));
  return[...base,...synth];
}

// ==================== TOAST ====================
let _toastTimer;
function showToast(msg,type){
  const t=document.getElementById('toast');
  t.textContent=msg;t.className='toast'+(type==='warn'?' warn':'');
  clearTimeout(_toastTimer);
  requestAnimationFrame(()=>{t.classList.add('show');_toastTimer=setTimeout(()=>t.classList.remove('show'),1600)});
}

// ==================== 重叠机制 & 非方形命中 ====================
// 深度：物品按 y 坐标排序（z=30+y，越靠画面下方越在前），悬停/选中由 CSS 临时置顶。
// 命中：把图标光栅化到 48×48 透明度蒙版，按 alpha 抠边判定——点在透明像素上
// 会穿透到下层物品；图片图标按 PNG alpha，emoji 按字形轮廓；±2 蒙版像素容差便于手指点按。
const _masks={};
function _buildMask(draw){
  const N=48,c=document.createElement('canvas');c.width=N;c.height=N;
  const ctx=c.getContext('2d',{willReadFrequently:true});
  try{draw(ctx,N);return{n:N,d:ctx.getImageData(0,0,N,N).data}}catch(e){return null}
}
function _maskFor(card){
  const img=card.querySelector('.ico:not(.noimg) img');
  if(img&&img.complete&&img.naturalWidth){
    const k='i:'+img.src;
    if(!(k in _masks))_masks[k]=_buildMask((ctx,N)=>ctx.drawImage(img,0,0,N,N));
    return{mask:_masks[k],node:img};
  }
  const em=card.querySelector('.item-emoji');
  const ch=em?em.textContent.trim():'';
  if(!ch)return{mask:null,node:card};
  const k='e:'+ch;
  if(!(k in _masks))_masks[k]=_buildMask((ctx,N)=>{ctx.font=Math.round(N*.86)+'px sans-serif';ctx.textAlign='center';ctx.textBaseline='middle';ctx.fillText(ch,N/2,N/2+N*.04)});
  return{mask:_masks[k],node:em};
}
function _hitCard(card,cx,cy){
  const{mask,node}=_maskFor(card);
  if(!mask){const b=card.getBoundingClientRect();return cx>=b.left&&cx<=b.right&&cy>=b.top&&cy<=b.bottom} // 取不到像素（如 file:// 跨域）退回矩形
  const r=node.getBoundingClientRect();if(!r.width||!r.height)return false;
  const mx=Math.round((cx-r.left)/r.width*(mask.n-1)),my=Math.round((cy-r.top)/r.height*(mask.n-1));
  for(let dy=-2;dy<=2;dy++)for(let dx=-2;dx<=2;dx++){
    const x=mx+dx,y=my+dy;
    if(x<0||y<0||x>=mask.n||y>=mask.n)continue;
    if(mask.d[(y*mask.n+x)*4+3]>16)return true;
  }
  return false;
}
function topHitCard(cx,cy){
  const seen=new Set();
  for(const e of document.elementsFromPoint(cx,cy)){
    const c=e.closest?e.closest('.item-card'):null;
    if(!c||seen.has(c))continue;
    seen.add(c);
    if(_hitCard(c,cx,cy))return c;
  }
  return null;
}
function bindScenePointer(container){
  if(editing()){container.onclick=container.onpointermove=container.onpointerleave=null;return}
  container.onclick=e=>{
    const c=topHitCard(e.clientX,e.clientY);if(!c)return;
    if(c.dataset.act==='rev')revealItem(c.dataset.id,c);
    else if(c.dataset.act==='sel')toggleSelect(c.dataset.id);
  };
  container.onpointermove=e=>{
    if(e.pointerType==='touch')return; // 触屏没有悬停概念，点按会触发 pointermove 留下擦不掉的 .hov
    const c=topHitCard(e.clientX,e.clientY);
    container.querySelectorAll('.item-card.hov').forEach(el=>{if(el!==c)el.classList.remove('hov')});
    if(c)c.classList.add('hov');
  };
  container.onpointerleave=()=>container.querySelectorAll('.item-card.hov').forEach(el=>el.classList.remove('hov'));
}

// ==================== RENDER ====================
function renderRoom(){
  // 注意：这里不再 zoomReset——点物品/合成后的重绘要保持当前缩放；只有切房间才复位（nextRoom/prevRoom/mapGoto）
  const room=ROOMS[S.currentRoom];
  const tutMode=TUT.active&&!editing(); // 教程=独立场景：与真实房间/坐标/存档揭示状态全解耦
  document.getElementById('roomTitle').textContent=tutMode?'训练场 · Bootcamp':room.name;
  const rd=document.getElementById('roomDesc');
  if(tutMode){rd.textContent='教官的私人炼金练习室';rd.style.display=''}
  else{rd.textContent=room.desc||'';rd.style.display=room.desc?'':'none'}
  document.getElementById('roomDots').innerHTML=ROOMS.map((_,i)=>{
    const r=ROOMS[i];const u=isUnlocked(r);
    let cls='room-dot';if(i===S.currentRoom)cls+=' active';if(!u)cls+=' locked';
    return`<span class="${cls}"></span>`;
  }).join('');

  const container=document.getElementById('roomContainer');
  // Build scene
  let items;
  if(tutMode){
    // 独立教程场景：三个教程物品摆固定训练位；揭示显示状态用 TUT.rev（不动 S.revealed，
    // 老玩家重看也能重新体验点❓），与 S.currentRoom、positions.json 坐标完全无关
    items=TUT_ITEMS.map(id=>Object.assign({},itemMap[id],{id,x:TUT_SPOTS[id].x,y:TUT_SPOTS[id].y,w:TUT_SPOTS[id].w,h:TUT_SPOTS[id].w}));
  }else{
    items=editing()?[...BASE_ITEMS.filter(i=>i.room===room.id),...SYNTH_ITEMS.filter(i=>i.room===room.id)]:getRoomItems(room.id);
  }
  let html=`<div class="room-scene" id="roomScene"><div class="room-zoom" id="roomZoom">`;
  if(tutMode){
    html+=`<div class="scene-bg tut-stage"><div class="tut-stage-title">炼 金 训 练 场</div></div>`;
  }else{
    const bgPath=room.bgImg||('rooms/'+room.id+'_bg.webp');
    const bgImg=USE_IMG?`<img class="scene-bg-img" src="${assetURL(bgPath)}" onerror="this.remove()" draggable="false">`:'';
    html+=`<div class="scene-bg plain">${bgImg}</div>`;
    if(room.extras)html+=room.extras; // 房间附加装饰（如老板办公室的老板立绘）
  }
  items.forEach(it=>{
    const style=`top:${it.y}%;left:${it.x}%;z-index:${30+Math.round(it.y||0)}`;
    const ef=(it.w||it.h)?` style="font-size:${Math.min(it.w||60,it.h||60)}px"`:'';
    if(editing()){
      html+=`<div class="item-card revealed${it.isSynth?' synth-item':''}" data-id="${it.id}" style="${style}"><span class="up" onclick="event.stopPropagation();pickImage('items/${it.id}.webp','${it.name}')">📷</span><span class="item-emoji"${ef}>${itemIcon(it)}</span><span class="item-name">${it.name}</span><span class="rz"></span></div>`;
    }else if(it.isSynth){
      const sel=S.slots.includes(it.id)?'selected':'';
      html+=`<div class="item-card revealed synth-item ${sel}" data-id="${it.id}" data-act="sel" style="${style}"><span class="item-emoji"${ef}>${itemIcon(it)}</span><span class="item-name">${it.name}</span></div>`;
    }else if(tutMode?!TUT.rev.includes(it.id):!isRevealed(it.id)){ // 教程场景：❓/揭示只看 TUT.rev，与存档无关
      html+=`<div class="item-card hidden-item" data-id="${it.id}" data-act="rev" style="${style}"><span class="discover-hint">❓</span><span class="item-emoji"${ef}>${itemIcon(it)}</span><span class="item-name">${it.name}</span></div>`;
    }else{
      const sel=S.slots.includes(it.id)?'selected':'';
      html+=`<div class="item-card revealed ${sel}" data-id="${it.id}" data-act="sel" style="${style}"><span class="item-emoji"${ef}>${itemIcon(it)}</span><span class="item-name">${it.name}</span></div>`;
    }
  });
  html+=`</div></div>`; // 关 .room-zoom 和 .room-scene
  // 缩放提示按钮：左上缩小、右上放大（在容器上、不随场景缩放；编辑模式 CSS 隐藏）
  html+=`<div class="zoom-btn zb-in" title="放大" onclick="event.stopPropagation();zmStep(1.6)">＋</div><div class="zoom-btn zb-out" title="缩小" onclick="event.stopPropagation();zmStep(1/1.6)">－</div>`;
  container.innerHTML=html;
  const bm=container.querySelector('.boss-man');
  if(bm){
    // 老板是彩蛋物品：平时不在房间里，集齐岗位触发「老板的召唤」后才现身；编辑模式始终可见可拖拽
    if(!editing()&&!S.bossReady){bm.remove()}
    else{
      const bp=room.bossMan;
      if(bp)bm.style.cssText+=`;left:${bp.x}%;top:${bp.y}%;width:${bp.w}%;height:${bp.h}%`;
      if(editing()){
        bm.innerHTML='<span class="rz"></span>';
        bm.onpointerdown=e=>editBossDrag(e,bm,room);
        bm.ondblclick=()=>{delete room.bossMan;renderRoom();showToast('老板立绘已重置回默认位置')};
      }else{bm.classList.add('active');bm.title='老板想和你聊聊';bm.onclick=e=>{e.stopPropagation();showBossLine()}}
    }
  }
  document.getElementById('btnPrev').classList.toggle('disabled',S.currentRoom===0);
  document.getElementById('btnNext').classList.toggle('disabled',S.currentRoom===ROOMS.length-1);
  fitScene();
  bindScenePointer(container);
  zmApply(); // 场景元素重建后把缩放状态重新打到新的 .room-zoom 上
  fixEdgeLabels();
  if(editing())container.querySelectorAll('.item-card').forEach(el=>{
    el.onpointerdown=e=>editDrag(e,el);
    el.ondblclick=()=>{
      const it=itemMap[el.dataset.id];if(!it)return;
      delete it.w;delete it.h;
      const r=ITEM_RECIPES.find(x=>x.result===it.id);if(r){delete r.w;delete r.h}
      renderRoom();showToast(it.name+' 尺寸已重置');
    };
  });
  if(TUT.active)tutRender(); // 场景重绘后教程高亮框重新对位
}

// 边缘物品的名字标签会被场景 overflow 裁掉：只挪标签，物品位置不动
// 水平超出就往内平移；游玩模式标签在卡片上方（顶边物品翻到下方），编辑模式在下方（底边物品翻到上方）
function fixEdgeLabels(){
  const scene=zmScene();if(!scene)return;
  const SW=scene.offsetWidth,SH=scene.offsetHeight,edit=editing();
  scene.querySelectorAll('.item-card').forEach(card=>{
    const nm=card.querySelector('.item-name');if(!nm)return;
    if(getComputedStyle(nm).display==='none')return;
    nm.style.left='';nm.style.top='';nm.style.bottom=''; // 先复位再量
    const half=nm.offsetWidth/2,lh=nm.offsetHeight,cx=card.offsetLeft+card.offsetWidth/2;
    let shift=0;
    if(cx-half<2)shift=2-(cx-half);
    else if(cx+half>SW-2)shift=(SW-2)-(cx+half);
    if(shift)nm.style.left=`calc(50% + ${shift.toFixed(1)}px)`;
    if(!edit&&card.offsetTop<lh+4){nm.style.top='calc(100% + 2px)';nm.style.bottom='auto'}
    else if(edit&&card.offsetTop+card.offsetHeight+lh+3>SH){nm.style.top='auto';nm.style.bottom='calc(100% + 1px)'}
  });
}
function renderSlots(){  for(let i=0;i<2;i++){
    const el=document.getElementById('cs'+i);
    if(S.slots[i]){
      const it=itemMap[S.slots[i]];
      el.className='c-slot filled';
      el.innerHTML=`<span class="cs-emoji">${itemIcon(it)}</span><span class="cs-name">${it.name}</span>`;
    }else{
      el.className='c-slot';
      el.innerHTML=`<span class="cs-num">${['①','②'][i]}</span>`;
    }
  }
  document.getElementById('craftBtn').disabled=S.slots.filter(Boolean).length<2;
}

function renderCodex(){
  let f=S.codexFilter;
  if(f!=='base'&&f!=='synth'&&f!=='job'&&f!=='egg')f='base'; // 兼容旧存档里的 all
  // 每类标签内显示收集进度（已发现/总数）；编辑模式只显示总数
  const cnt=(arr,has)=>editing()?arr.length:arr.filter(has).length+'/'+arr.length;
  const tabs=[
    {id:'base',l:'📦 基础物品 '+cnt(BASE_ITEMS,i=>isRevealed(i.id))},
    {id:'synth',l:'⚗️ 合成物品 '+cnt(ITEM_RECIPES,r=>S.discoveredItems.includes(r.key))},
    {id:'job',l:'💼 岗位 '+cnt(JOB_RECIPES,r=>S.discoveredJobs.includes(r.key))},
    {id:'egg',l:'🥚 惊喜彩蛋 '+cnt(EGGS,e=>S.discoveredEggs.includes(e.key))}];
  document.getElementById('codexTabs').innerHTML=tabs.map(t=>
    `<button class="codex-tab ${f===t.id?'active':''}" onclick="setCodexFilter('${t.id}')">${t.l}</button>`
  ).join('')+(editing()?`<button class="codex-tab" style="background:#22c55e;color:#fff;border-color:#22c55e" onclick="openRecipeForm()">➕ 添加公式</button>`:'');
  let items=[];
  if(f==='base')BASE_ITEMS.forEach(it=>items.push({emoji:it.emoji,icon:itemIcon(it),up:'items/'+it.id+'.webp',name:it.name,locked:!editing()&&!isRevealed(it.id),type:'base',data:it}));
  if(f==='synth')ITEM_RECIPES.forEach(r=>{if(!editing()&&!S.discoveredItems.includes(r.key))return;items.push({emoji:r.emoji,icon:itemIcon(itemMap[r.result]),up:'items/'+r.result+'.webp',name:r.name,locked:false,type:'synth',data:r})}); // 未合成的物品不显示影子，合成后直接出现
  if(f==='job')JOB_RECIPES.forEach(r=>items.push({emoji:r.emoji,icon:jobIcon(r),up:'jobs/'+r.job+'.webp',name:r.job,locked:!editing()&&!S.discoveredJobs.includes(r.key),type:'job',data:r}));
  if(f==='egg')EGGS.forEach(e=>{const ia=itemMap[e.a],ib=itemMap[e.b];items.push({emoji:e.emoji,icon:e.emoji,up:null,name:(ia?ia.name:e.a)+' + '+(ib?ib.name:e.b),locked:!editing()&&!S.discoveredEggs.includes(e.key),type:'egg',data:e})});
  window._cItems=items;
  document.getElementById('codexGrid').innerHTML=items.map((it,i)=>{
    const cls=it.locked?'codex-item locked':'codex-item';
    const e=it.locked?'❓':it.icon;const n=it.locked?'???':it.name;
    const oc=it.locked?'':`onclick="showCodexDetail(${i})"`;
    const del=(editing()&&(it.type==='synth'||it.type==='job'))?`<span class="del" onclick="event.stopPropagation();deleteRecipe('${it.type}','${it.data.key}')">✕</span>`:'';
    const up=(editing()&&it.up)?`<span class="up" onclick="event.stopPropagation();pickImage('${it.up}','${it.name}')">📷</span>`:'';
    return`<div class="${cls}" ${oc}>${up}${del}<span class="ci-emoji">${e}</span>${n}</div>`;
  }).join('');
}

// ==================== ACTIONS ====================
// 教程独立场景里的揭示：显示状态记 TUT.rev；新玩家顺手把物品真正收入存档，老玩家存档原样不动
function tutReveal(id,el){
  if(TUT.rev.includes(id))return;
  TUT.rev.push(id);
  if(!isRevealed(id)){S.revealed.push(id);save()}
  if(el)el.classList.add('discovering');
  const it=itemMap[id];
  showToast(((it&&it.emoji)||'✨')+' '+((it&&it.name)||id)+' 发现！');
  tutNotify('reveal',id);
  setTimeout(()=>renderRoom(),500);
  renderCodex();
}
function revealItem(id,el){
  if(TUT.active&&!editing()){tutReveal(id,el);return} // 教程场景走教程揭示（老玩家重看时 isRevealed 已 true，不能再被它挡死）
  if(isRevealed(id))return;
  S.revealed.push(id);save();tutNotify('reveal',id);
  el.classList.add('discovering');
  const it=itemMap[id];
  // 发现物品：弹幕 toast 改为弹窗（08-15 定稿；教程里仍用 toast，教程有自己的引导对话框，弹窗会抢戏）
  const ov=document.getElementById('resultOverlay'),card=document.getElementById('resultCard');
  card.innerHTML=`<div class="p-emoji">${itemIcon(it)}</div><div class="p-title">${it.name}</div><div class="p-tag new">✨ 新物品发现！</div><div class="p-desc">${it.desc||''}</div><button onclick="closeOv()">收下</button>`;
  ov.classList.add('show');
  setTimeout(()=>renderRoom(),500);
  renderCodex();
}

function toggleSelect(id){
  if(!canUseItem(id))return;
  const idx=S.slots.indexOf(id);
  if(idx>=0){S.slots[idx]=null;const f=S.slots.filter(Boolean);S.slots=[f[0]||null,f[1]||null]}
  else{for(let i=0;i<2;i++){if(!S.slots[i]){S.slots[i]=id;break}}}
  renderRoom();renderSlots();
}

function removeCraftSlot(i){
  if(!S.slots[i])return;
  S.slots[i]=null;const f=S.slots.filter(Boolean);S.slots=[f[0]||null,f[1]||null];
  renderRoom();renderSlots();
}
function clearCraft(){S.slots=[null,null];renderRoom();renderSlots()}

function prevRoom(){
  if(TUT.active)return; // 教程独立场景期间禁止切房（键盘方向键也走这里）
  if(S.currentRoom<=0)return;
  zoomReset(); // 复位缩放，否则内联 transform 会压住滑出动画
  const el=document.getElementById('roomScene');
  if(!el)return;
  el.classList.add('slide-out-right');
  setTimeout(()=>{S.currentRoom--;
    if(!isUnlocked(ROOMS[S.currentRoom])){showToast('🔒 '+ROOMS[S.currentRoom].unlockText,'warn');S.currentRoom++;renderRoom();return}
    renderRoom();renderSlots();
  },200);
}
function nextRoom(){
  if(TUT.active)return; // 教程独立场景期间禁止切房
  if(S.currentRoom>=ROOMS.length-1)return;
  zoomReset(); // 复位缩放，否则内联 transform 会压住滑出动画
  const el=document.getElementById('roomScene');
  if(!el)return;
  el.classList.add('slide-out-left');
  setTimeout(()=>{S.currentRoom++;
    if(!isUnlocked(ROOMS[S.currentRoom])){showToast('🔒 '+ROOMS[S.currentRoom].unlockText,'warn');S.currentRoom--;renderRoom();return}
    renderRoom();renderSlots();
  },200);
}

function doCraft(){
  const a=S.slots[0],b=S.slots[1];if(!a||!b)return;
  const key=[a,b].sort().join('+');
  const ov=document.getElementById('resultOverlay'),card=document.getElementById('resultCard');
  const ir=itemRecipeLookup[key];
  if(ir){
    const isNew=!S.discoveredItems.includes(key);
    if(isNew){S.discoveredItems.push(key);save()}
    const formula=itemIcon(itemMap[ir.a])+itemMap[ir.a].name+' + '+itemIcon(itemMap[ir.b])+itemMap[ir.b].name;
    card.innerHTML=`<div class="p-emoji">${itemIcon(itemMap[ir.result])}</div><div class="p-title">${ir.name}</div><div class="p-formula">${formula}</div><div class="p-tag ${isNew?'new':'dup'}">${isNew?'🎉 新物品合成！':'✅ 已合成过'}</div><div class="p-desc">${ir.desc}</div><button onclick="closeOv()">继续</button>`;
    ov.classList.add('show');tutNotify('craft',{key,kind:'item'});S.slots=[null,null];renderRoom();renderSlots();renderCodex();checkUnlocks();return;
  }
  const jr=jobRecipeLookup[key];
  if(jr){
    const isNew=!S.discoveredJobs.includes(key);
    if(isNew){S.discoveredJobs.push(key);save();NET.track('job_unlocked',{job:jr.job})}
    checkBossEgg();
    const formula=itemIcon(itemMap[jr.a])+itemMap[jr.a].name+' + '+itemIcon(itemMap[jr.b])+itemMap[jr.b].name;
    card.innerHTML=`<div class="p-emoji">${jobIcon(jr)}</div><div class="p-title">${jr.job}</div><div class="p-formula">${formula}</div><div class="p-tag ${isNew?'new':'dup'}">${isNew?'🎉 新岗位解锁！':'✅ 已解锁过'}</div><div class="p-desc">${jr.desc.replace(/\n/g,'<br>')}</div><button onclick="closeOv()">继续</button>`;
    ov.classList.add('show');tutNotify('craft',{key,kind:'job',job:jr.job});S.slots=[null,null];renderRoom();renderSlots();renderCodex();checkUnlocks();return;
  }
  const egg=EASTER_EGGS[key];
  if(egg&&!S.discoveredEggs.includes(key)){S.discoveredEggs.push(key);save();renderCodex()}
  const failMsg=egg?egg.msg:fillAB(GENERIC_FAILS[Math.floor(Math.random()*GENERIC_FAILS.length)],itemMap[a].name,itemMap[b].name);
  card.innerHTML=`<div class="p-emoji">${egg?egg.emoji:'💨'}</div><div class="p-fail">${egg?'彩蛋！':'合成失败'}</div><div class="p-formula">${itemIcon(itemMap[a])} + ${itemIcon(itemMap[b])}</div><div class="p-egg">${failMsg}</div><button onclick="closeOv()">再试试</button>`;
  ov.classList.add('show');tutNotify('craft',{key,kind:'fail'});S.slots=[null,null];renderRoom();renderSlots();
}

// ==================== 老板彩蛋 ====================
// 集齐全部岗位后触发：先弹「老板的召唤」，之后老板办公室里的老板立绘可点击
const BOSS_EGG=D.bossEgg||{};
let _bossInvitePending=false;
function checkBossEgg(){
  if(!S.bossReady&&S.discoveredJobs.length>=JOB_RECIPES.length){S.bossReady=true;_bossInvitePending=true;save()}
}
function showBossInvite(){
  const ov=document.getElementById('resultOverlay'),card=document.getElementById('resultCard');
  card.innerHTML=`<div class="p-emoji">🚪</div><div class="p-title">老板的召唤</div><div class="p-desc">${BOSS_EGG.readyText||'老板在办公室想和你聊聊'}</div><button onclick="closeOv()">好的</button>`;
  ov.classList.add('show');
}
function showBossLine(){
  const ov=document.getElementById('resultOverlay'),card=document.getElementById('resultCard');
  const bossImg=USE_IMG?`<img src="${assetURL('decor/老板.webp')}" style="max-width:45%;max-height:180px" onerror="this.outerHTML='🧑‍💼'" draggable="false">`:'🧑‍💼';
  card.innerHTML=`<div class="p-emoji">${bossImg}</div><div class="p-title">老板</div><div class="p-desc">${BOSS_EGG.line||'恭喜你，祝您未来一帆风顺'}</div><button onclick="closeOv()">关闭</button>`;
  ov.classList.add('show');
  if(!S.bossMet){S.bossMet=true;save();renderRoom()}
}

let _unlockState={};
function checkUnlocks(){
  const jc=jobCount();
  ROOMS.forEach(r=>{
    if(r.unlockAt>0&&jc>=r.unlockAt&&!_unlockState[r.id]){
      _unlockState[r.id]=true;
      setTimeout(()=>showToast('🔓 '+r.emoji+' '+r.name+' 已解锁！','warn'),500);
    }
  });
}
function initUnlocks(){ROOMS.forEach(r=>{if(r.unlockAt>0&&jobCount()>=r.unlockAt)_unlockState[r.id]=true})}

function showHint(){
  tutNotify('hint');
  // 只把「已解锁房间里」的物品算作可用原料，避免提示提到还没解锁的房间的东西
  const roomOpen=id=>{const it=itemMap[id];if(!it||!it.room)return false;const rm=ROOMS.find(r=>r.id===it.room);return rm?isUnlocked(rm):false};
  const owned=[];
  BASE_ITEMS.forEach(i=>{if(isRevealed(i.id)&&roomOpen(i.id))owned.push(i.id)});
  SYNTH_ITEMS.forEach(i=>{if(isSynthOwned(i.id)&&roomOpen(i.id))owned.push(i.id)});
  let hint='';
  const possI=ITEM_RECIPES.filter(r=>!S.discoveredItems.includes(r.key)&&owned.includes(r.a)&&owned.includes(r.b));
  const possJ=JOB_RECIPES.filter(r=>!S.discoveredJobs.includes(r.key)&&owned.includes(r.a)&&owned.includes(r.b));
  const pick=(arr)=>arr[Math.floor(Math.random()*arr.length)];
  // 教程期间提示锁定为「前台」配方：老玩家重看教程时持有物很多，随机池会指到别的配方
  if(TUT.active){
    const r=jobRecipeLookup[['快递','招财猫'].sort().join('+')];
    const t=HINT_TEXTS.length?pick(HINT_TEXTS):'试试【A】和【B】';
    if(r)hint=fillAB(t,itemMap[r.a].name,itemMap[r.b].name);
  }
  if(!hint){
  if(possI.length>0||possJ.length>0){
    const r=possI.length>0?pick(possI):pick(possJ);
    const t=HINT_TEXTS.length?pick(HINT_TEXTS):'试试【A】和【B】';
    hint=fillAB(t,itemMap[r.a].name,itemMap[r.b].name);
  }
  else if(owned.length<ALL_ITEMS.length){
    const unrev=BASE_ITEMS.filter(i=>!isRevealed(i.id)&&isUnlocked(ROOMS.find(r=>r.id===i.room)));
    if(unrev.length>0)hint='还有物品没发现，多点点房间里的问号！';
    else{const lr=ROOMS.filter(r=>!isUnlocked(r));if(lr.length>0)hint=`还有${lr.length}个房间没解锁，多合成岗位试试！`;else hint='多试试不同组合吧！'}
  }else{const rem=TOTAL-S.discoveredItems.length-S.discoveredJobs.length;hint=rem>0?`还有${rem}个配方等你发现！`:'🎊 全部解锁！你是办公室炼金术大师！'}
  }
  const ov=document.getElementById('resultOverlay'),card=document.getElementById('resultCard');
  card.innerHTML=`<div class="p-emoji">💡</div><div class="p-title">提示</div><div class="p-desc">${hint}</div><button onclick="closeOv()">知道了</button>`;
  ov.classList.add('show');
}

function openCodex(){tutNotify('codex');renderCodex();document.getElementById('codexOverlay').classList.add('show')}
function closeCodex(){document.getElementById('codexOverlay').classList.remove('show')}
function setCodexFilter(f){S.codexFilter=f;renderCodex()}

// ==================== COMPANY MAP ====================
// 平面图由 data.js 的 mapLayout 驱动：每行一个数组，单房间行横跨整行
// 地图：横向轮轴滚动 + 居中聚焦舞台，卡片直接使用场景背景图
let _mapFocus=-1,_mapScrollBound=false;
function renderMap(){
  const track=document.getElementById('mapTrack');
  track.innerHTML=ROOMS.map((r,i)=>{
    const u=isUnlocked(r);
    const bg=USE_IMG?assetURL(r.bgImg||('rooms/'+r.id+'_bg.webp')):'';
    const base=BASE_ITEMS.filter(x=>x.room===r.id),syn=ITEM_RECIPES.filter(x=>x.room===r.id);
    const found=base.filter(x=>isRevealed(x.id)).length+syn.filter(x=>S.discoveredItems.includes(x.key)).length;
    return`<div class="map-card${u?'':' locked'}" onclick="mapCardClick(${i})">`
      +(bg?`<img src="${bg}" onerror="this.remove()" draggable="false">`:'')
      +`<div class="mc-label">${u?`${r.name}<span class="mc-count">${found}/${base.length+syn.length}</span>`:`🔒 ${r.name}`}</div>`
      +(u?'':`<div class="mc-locktxt">${r.unlockText||('合成'+r.unlockAt+'个岗位解锁')}<br>岗位进度 ${jobCount()}/${r.unlockAt}</div>`)
      +`</div>`;
  }).join('');
  if(!_mapScrollBound){
    _mapScrollBound=true;
    let _t=null;
    track.addEventListener('scroll',()=>{if(_t)cancelAnimationFrame(_t);_t=requestAnimationFrame(updateMapFocus)},{passive:true});
  }
  _mapFocus=-1;
  requestAnimationFrame(()=>{centerMapCard(S.currentRoom,false);updateMapFocus()});
}
function centerMapCard(i,smooth=true){
  const track=document.getElementById('mapTrack'),card=track.children[i];if(!card)return;
  track.scrollTo({left:card.offsetLeft-(track.clientWidth-card.offsetWidth)/2,behavior:smooth?'smooth':'auto'});
}
function updateMapFocus(){
  const track=document.getElementById('mapTrack');if(!track||!track.children.length)return;
  const c=track.scrollLeft+track.clientWidth/2;
  let best=0,bd=1e9;
  [...track.children].forEach((el,i)=>{
    const d=Math.abs(el.offsetLeft+el.offsetWidth/2-c);
    if(d<bd){bd=d;best=i}
  });
  _mapFocus=best;
  [...track.children].forEach((el,i)=>el.classList.toggle('focus',i===best));
  // 聚光灯：暗色面纱在聚焦卡片处开一个 radial 亮洞（注意 body 可能整体 scale，需换算成 overlay 本地坐标）
  const ov=document.getElementById('mapOverlay');
  const card=track.children[best];
  const or=ov.getBoundingClientRect(),cr=card.getBoundingClientRect();
  const sc=ov.offsetWidth/or.width||1;
  const x=(cr.left+cr.width/2-or.left)*sc,y=(cr.top+cr.height/2-or.top)*sc;
  const rad=Math.max(cr.width,cr.height)*sc*0.72;
  ov.style.background=`radial-gradient(circle ${rad}px at ${x}px ${y}px, rgba(24,17,8,0) 52%, rgba(24,17,8,.8) 100%)`;
}
function mapCardClick(i){
  if(_mapFocus!==i){centerMapCard(i);return}
  mapGoto(i);
}
function mapGoto(idx){
  if(TUT.active)return; // 教程独立场景期间禁止跳房间
  const r=ROOMS[idx];
  if(!isUnlocked(r)){showToast('🔒 '+(r.unlockText||('合成'+r.unlockAt+'个岗位解锁'))+'（岗位 '+jobCount()+'/'+r.unlockAt+'）','warn');return}
  S.currentRoom=idx;closeMap();zoomReset();renderRoom();renderSlots();
}
function openMap(){renderMap();document.getElementById('mapOverlay').classList.add('show')}
function closeMap(){document.getElementById('mapOverlay').classList.remove('show')}

function showCodexDetail(idx){
  const it=window._cItems[idx];if(!it||it.locked)return;
  const ov=document.getElementById('detailOverlay'),card=document.getElementById('detailCard');
  let formula='',desc='';
  if(it.type==='base'){const rm=ROOMS.find(r=>r.id===it.data.room);desc=(it.data.desc?it.data.desc+'<br>':'')+'来自：'+(rm?rm.emoji+' '+rm.name:'未知')}
  else if(it.type==='synth'){formula=itemIcon(itemMap[it.data.a])+itemMap[it.data.a].name+' + '+itemIcon(itemMap[it.data.b])+itemMap[it.data.b].name;desc=it.data.desc}
  else if(it.type==='job'){formula=itemIcon(itemMap[it.data.a])+itemMap[it.data.a].name+' + '+itemIcon(itemMap[it.data.b])+itemMap[it.data.b].name;desc=it.data.desc.replace(/\n/g,'<br>')}
  else if(it.type==='egg'){const ia=itemMap[it.data.a],ib=itemMap[it.data.b];formula=(ia?itemIcon(ia)+ia.name:it.data.a)+' + '+(ib?itemIcon(ib)+ib.name:it.data.b);desc=it.data.emoji+' '+it.data.msg}
  const moreBtn=(it.type==='job'&&it.data.card)?`<button onclick="showJobCard(${idx})" style="margin-right:8px">查看更多</button>`:'';
  card.innerHTML=`<div class="p-emoji">${it.icon}</div><div class="p-title">${it.name}</div>${formula?`<div class="p-formula">${formula}</div>`:''}<div class="p-desc">${desc}</div>${moreBtn}<button onclick="closeOv2()">关闭</button>`;
  ov.classList.add('show');
  document.getElementById('codexOverlay').classList.remove('show');
}

// 岗位图鉴二级页：岗位卡片（标签/职责/上下游/薪资/出没地）
function showJobCard(idx){
  const it=window._cItems[idx];if(!it||it.locked||it.type!=='job')return;
  const c=it.data.card;if(!c)return;
  const card=document.getElementById('detailCard');
  const row=(l,v)=>v?`<div style="margin-bottom:10px"><div style="color:#e2b96f;font-weight:700;margin-bottom:3px">${l}</div><div style="white-space:pre-line">${v}</div></div>`:'';
  const sal=c.salary?c.salary.split(/\s*[|｜]\s*/).filter(Boolean).join('\n'):''; // 薪资带宽按 | 分行（数据里是全角｜）
  card.innerHTML=`<div class="p-emoji">${it.icon}</div><div class="p-title">${it.name}</div>${c.tag?`<div class="p-tag">${c.tag}</div>`:''}<div class="p-desc" style="text-align:left;max-height:46vh;overflow-y:auto">${row('📋 工作职责',c.duties)}${row('🔗 岗位上下游',c.chain)}${row('💰 薪资带宽',sal)}${row('📍 岗位出没地',c.habitat)}</div><button onclick="showCodexDetail(${idx})" style="margin-right:8px">‹ 返回</button><button onclick="closeOv2()">关闭</button>`;
}

function closeOverlay(e){if(e.target.classList.contains('overlay'))e.target.classList.remove('show')}
function closeOv(){document.getElementById('resultOverlay').classList.remove('show');tutNotify('popupClosed');if(_bossInvitePending){_bossInvitePending=false;setTimeout(showBossInvite,300)}}
function closeOv2(){document.getElementById('detailOverlay').classList.remove('show')}


// ==================== EDIT MODE & VALIDATOR ====================
function initEditMode(){
  document.body.classList.add('editing','edit-mode');
  const bar=document.createElement('div');
  bar.className='edit-bar';
  bar.innerHTML=`<span id="editBarLabel">🛠 编辑模式</span><button onclick="pickBg()">🖼 背景</button><button onclick="saveData()">💾 保存</button><button onclick="publishAll()">🚀 发布</button><button onclick="showValidation()">校验</button><button onclick="fitAllCards()">📦 贴框</button><button id="lpBtn" onclick="toggleLivePreview()">预览正式版</button>`;
  document.body.appendChild(bar);
}
// 上传当前房间的场景背景图（约定路径 assets/rooms/<房间id>_bg.webp，可用 room.bgImg 覆盖）
function pickBg(){
  const r=ROOMS[S.currentRoom];
  pickImage(r.bgImg||('rooms/'+r.id+'_bg.webp'),r.name+' 背景',1280);
}
// 就地实时预览：LIVE=true 时按正式版玩家视角渲染当前内存数据，编辑操作即时反映
let LIVE=false;
function editing(){return EDIT&&!LIVE}
function toggleLivePreview(){
  LIVE=!LIVE;
  document.body.classList.toggle('editing',editing());
  document.getElementById('lpBtn').textContent=LIVE?'✏️ 返回编辑':'预览正式版';
  document.getElementById('editBarLabel').textContent=LIVE?'👀 预览模式（实时跟随编辑）':'🛠 编辑模式';
  document.querySelector('.edit-bar').classList.toggle('live',LIVE);
  renderRoom();renderSlots();renderCodex();
}
// 一键贴框：遍历所有房间，把每个物品的 w/h 改写为当前图标字号(px)、卡片自动贴合图标，
// 同时平移 x/y 保证图标视觉位置纹丝不动。执行后需保存+发布，正式版同步生效。
async function fitAllCards(){
  if(!editing())return showToast('请先返回编辑模式');
  try{await document.fonts.ready}catch(_){} // 等像素字体加载完，字形度量才稳定
  const FB=1.6*parseFloat(getComputedStyle(document.body).fontSize); // 默认字号基准(px)
  const cur=S.currentRoom;let n=0;
  for(let ri=0;ri<ROOMS.length;ri++){
    S.currentRoom=ri;renderRoom();
    await new Promise(r=>setTimeout(r,350)); // 等图片加载稳定再量
    let scene=document.getElementById('roomScene');if(!scene)continue;
    let sr=scene.getBoundingClientRect();
    const k=sr.width/scene.offsetWidth||1; // 屏幕px/布局px（桌面整体缩放校正）
    const W=scene.offsetWidth,H=scene.offsetHeight;
    // 第一遍：按【旧语义】算出每个图标的视觉中心目标点，再写入【新语义】(字号px)的 w/h
    const targets={};
    for(const el of scene.querySelectorAll('.item-card')){
      const it=itemMap[el.dataset.id];if(!it)continue;
      const em=el.querySelector('.item-emoji');if(!em)continue;
      const legacy=it.w&&it.h&&it.w!==it.h; // 旧数据 w/h=卡片px且非正方形；约定迁移后 w===h
      const cw=legacy?it.w:60,ch=legacy?it.h:60;
      targets[it.id]=[(it.x/100*W+cw/2)*k,(it.y/100*H+ch/2)*k]; // 场景系屏幕px
      if(legacy){it.w=it.h=Math.round(Math.min(it.w,it.h)/60*FB)}
      else if(!(it.w&&it.h)){it.w=it.h=Math.round(parseFloat(getComputedStyle(em).fontSize)||FB)}
      n++;
    }
    renderRoom();
    await new Promise(r=>setTimeout(r,150));
    // 第二遍：量新中心，把 x/y 平移到旧语义目标点（不假设任何字形度量）
    scene=document.getElementById('roomScene');sr=scene.getBoundingClientRect();
    for(const el of scene.querySelectorAll('.item-card')){
      const it=itemMap[el.dataset.id];if(!it||!targets[it.id])continue;
      const em=el.querySelector('.item-emoji');if(!em)continue;
      const er=em.getBoundingClientRect();
      const dx=(targets[it.id][0]-(er.left+er.width/2-sr.left))/sr.width*100;
      const dy=(targets[it.id][1]-(er.top+er.height/2-sr.top))/sr.height*100;
      it.x=Math.round((it.x+dx)*10)/10;it.y=Math.round((it.y+dy)*10)/10;
      const r=ITEM_RECIPES.find(x=>x.result===it.id);
      if(r){r.w=it.w;r.h=it.h;r.x=it.x;r.y=it.y}
    }
  }
  S.currentRoom=cur;renderRoom();
  showToast(`已贴框 ${n} 个物品（全部房间），请保存并发布`);
}
let _drag=null;
function editDrag(e,el){
  e.preventDefault();
  const scene=document.getElementById('roomScene');if(!scene)return;
  const rect=scene.getBoundingClientRect();
  const id=el.dataset.id;
  if(e.target.classList.contains('up'))return;
  const isResize=e.target.classList.contains('rz');
  try{el.setPointerCapture(e.pointerId)}catch(_){}
  // 桌面端 body 可能整体 scale 缩放：clientX/rect 是屏幕坐标，offsetWidth 是布局坐标，必须换算成同一单位
  const scX=scene.offsetWidth/rect.width,scY=scene.offsetHeight/rect.height;
  const it=itemMap[id];
  const sx=e.clientX,sy=e.clientY,startX=it.x,startY=it.y;
  const em0=el.querySelector('.item-emoji');
  const f0=em0?parseFloat(getComputedStyle(em0).fontSize):25;
  const move=ev=>{
    if(isResize){
      // 框即图标：缩放直接改图标字号(px)，卡片自动贴合
      const f=Math.round(Math.max(12,Math.min(400,f0+((ev.clientX-sx)+(ev.clientY-sy))/2*scX)));
      if(em0)em0.style.fontSize=f+'px';
      _drag={id,w:f,h:f,resize:true};
    }else{
      let x=startX+(ev.clientX-sx)*scX/scene.offsetWidth*100;
      let y=startY+(ev.clientY-sy)*scY/scene.offsetHeight*100;
      // 允许卡片框出血到画幅外（最多半张卡），图标居中于卡片，这样图标能贴住场景边缘
      const wp=el.offsetWidth/scene.offsetWidth*100,hp=el.offsetHeight/scene.offsetHeight*100;
      x=Math.max(-wp/2,Math.min(100-wp/2,x));
      y=Math.max(-hp/2,Math.min(100-hp/2,y));
      el.style.left=x+'%';el.style.top=y+'%';el.style.zIndex=30+Math.round(y);
      _drag={id,x:Math.round(x*10)/10,y:Math.round(y*10)/10};
    }
  };
  const up=()=>{
    el.removeEventListener('pointermove',move);el.removeEventListener('pointerup',up);
    if(_drag&&_drag.id===id){
      const it=itemMap[id];
      const r=ITEM_RECIPES.find(x=>x.result===id);
      if(_drag.resize){
        it.w=_drag.w;it.h=_drag.h;
        if(r){r.w=_drag.w;r.h=_drag.h}
        showToast(`${it.name} → 图标:${it.w}px`);
      }else{
        it.x=_drag.x;it.y=_drag.y;
        if(r){r.x=_drag.x;r.y=_drag.y}
        showToast(`${it.name} → x:${it.x} y:${it.y}`);
      }
      _drag=null;
    }
  };
  el.addEventListener('pointermove',move);el.addEventListener('pointerup',up);
}
// 编辑模式拖拽老板立绘：位置/尺寸均为场景百分比，存 room.bossMan（x=left y=top w=width h=height），随保存写回 data.js
function editBossDrag(e,el,room){
  e.preventDefault();e.stopPropagation();
  const scene=document.getElementById('roomScene');if(!scene)return;
  const rect=scene.getBoundingClientRect();
  const isResize=e.target.classList.contains('rz');
  try{el.setPointerCapture(e.pointerId)}catch(_){}
  // 桌面端 body 可能整体 scale：同 editDrag，屏幕坐标要换算成布局坐标
  const scX=scene.offsetWidth/rect.width,scY=scene.offsetHeight/rect.height;
  const p0={x:parseFloat(el.style.left)||64,y:parseFloat(el.style.top)||46,w:parseFloat(el.style.width)||14,h:parseFloat(el.style.height)||43};
  const sx=e.clientX,sy=e.clientY;
  let _bd=null;
  const move=ev=>{
    const dx=(ev.clientX-sx)*scX/scene.offsetWidth*100,dy=(ev.clientY-sy)*scY/scene.offsetHeight*100;
    if(isResize){
      const w=Math.round(Math.max(4,Math.min(60,p0.w+dx))*10)/10,h=Math.round(Math.max(4,Math.min(90,p0.h+dy))*10)/10;
      el.style.width=w+'%';el.style.height=h+'%';
      _bd={x:p0.x,y:p0.y,w,h};
    }else{
      const x=Math.round(Math.max(-10,Math.min(100,p0.x+dx))*10)/10,y=Math.round(Math.max(-10,Math.min(100,p0.y+dy))*10)/10;
      el.style.left=x+'%';el.style.top=y+'%';
      _bd={x,y,w:p0.w,h:p0.h};
    }
  };
  const up=()=>{
    el.removeEventListener('pointermove',move);el.removeEventListener('pointerup',up);
    if(_bd){room.bossMan=_bd;showToast(isResize?`老板立绘 → 宽:${_bd.w}% 高:${_bd.h}%`:`老板立绘 → x:${_bd.x} y:${_bd.y}`);_bd=null}
  };
  el.addEventListener('pointermove',move);el.addEventListener('pointerup',up);
}
// ===== 保存 / 发布（需要 devserver.py） =====
// 把内存中的最新数据（拖动后的坐标、房间 bgImg 等）写回 edit/data.js，再同步到正式版
const _SAVE_FIELDS={
  baseItems:['id','name','emoji','desc','room','x','y','w','h'],
  itemRecipes:['a','b','result','emoji','name','desc','room','x','y','w','h'],
  rooms:['id','name','emoji','unlockAt','unlockText','scene','entrance','desc','bgImg','extras','bossMan'],
};
function _cleanArr(arr,keys){
  return arr.map(o=>{
    const r={};
    keys.forEach(k=>{
      let v=o[k];
      if(v===undefined)return;
      if(k==='x'||k==='y')v=+v.toFixed(1);
      r[k]=v;
    });
    return r;
  });
}
async function saveData(silent){
  try{
    const cur=await (await fetch('data.js?_='+Date.now())).text();
    let text=cur;
    const swap=(name,json)=>{
      const re=new RegExp(name+':\\[[\\s\\S]*?\\]');
      if(!re.test(text))throw new Error('data.js 中未找到 '+name+' 数组');
      text=text.replace(re,name+':'+json);
    };
    swap('baseItems',JSON.stringify(_cleanArr(BASE_ITEMS,_SAVE_FIELDS.baseItems)));
    swap('itemRecipes',JSON.stringify(_cleanArr(ITEM_RECIPES,_SAVE_FIELDS.itemRecipes)));
    swap('rooms',JSON.stringify(_cleanArr(ROOMS,_SAVE_FIELDS.rooms)));
    const res=await fetch('save-data',{method:'POST',body:text});
    if(!res.ok)throw new Error('HTTP '+res.status);
    if(!silent)showToast('💾 已保存到 edit/data.js');
  }catch(e){
    showToast('⚠️ 保存失败：'+(e.message||'请用 python3 devserver.py 启动本地服务器'),'warn');
    throw e;
  }
}
async function publishAll(){
  try{
    showToast('正在保存并发布…');
    await saveData(true);
    const res=await fetch('publish',{method:'POST'});
    if(!res.ok)throw new Error('HTTP '+res.status);
    const j=await res.json();
    _imgVer++;localStorage.setItem('jc_imgver',_imgVer);
    renderRoom();
    showToast(`🚀 已发布到正式版（文件 ${j.copied.length} 个，图片 ${j.images} 张）`);
  }catch(e){
    if(!e||!e.message||!e.message.startsWith('data.js'))showToast('⚠️ 发布失败：请用 python3 devserver.py 启动本地服务器','warn');
  }
}

function editExport(){  const strip=r=>({a:r.a,b:r.b,result:r.result,emoji:r.emoji,name:r.name,desc:r.desc,room:r.room,x:r.x,y:r.y,w:r.w,h:r.h});
  const stripJ=r=>({a:r.a,b:r.b,job:r.job,emoji:r.emoji,desc:r.desc});
  const out='// 编辑后的最新数据，粘贴回 data.js 替换对应数组\nbaseItems:'+JSON.stringify(BASE_ITEMS)+',\n\nitemRecipes:'+JSON.stringify(ITEM_RECIPES.map(strip))+',\n\njobRecipes:'+JSON.stringify(JOB_RECIPES.map(stripJ))+',';
  const ov=document.getElementById('resultOverlay'),card=document.getElementById('resultCard');
  card.innerHTML=`<div class="p-title">导出坐标数据</div><div class="p-desc">包含拖动后的最新坐标，复制后替换 data.js 中的 baseItems / itemRecipes / jobRecipes</div><textarea class="export-ta" id="exportTa"></textarea><button onclick="navigator.clipboard.writeText(document.getElementById('exportTa').value).then(()=>showToast('已复制'))">复制</button> <button onclick="closeOv()">关闭</button>`;
  document.getElementById('exportTa').value=out;
  ov.classList.add('show');
}
function validateData(){
  const errs=[];
  if(!ROOMS.length)errs.push('rooms 为空');
  const roomIds=new Set(ROOMS.map(r=>r.id));
  const seen=new Set();
  ALL_ITEMS.forEach(i=>{
    if(seen.has(i.id))errs.push('物品id重复: '+i.id);
    seen.add(i.id);
    if(!roomIds.has(i.room))errs.push(`物品 ${i.id} 所在房间 ${i.room} 不存在`);
    if(i.x<-20||i.x>97||i.y<-17||i.y>97)errs.push(`物品 ${i.id} 坐标可能越界 x:${i.x} y:${i.y}`);
    // 不校验 w/h 尺寸：图标大小本来就是编辑模式里自由拖拽拉伸出来的
  });
  const ref=(id,src)=>{if(!itemMap[id])errs.push(`${src} 引用了不存在的物品id: ${id}`)};
  ITEM_RECIPES.forEach(r=>{ref(r.a,'物品配方['+r.name+']');ref(r.b,'物品配方['+r.name+']')});
  JOB_RECIPES.forEach(r=>{ref(r.a,'岗位['+r.job+']');ref(r.b,'岗位['+r.job+']')});
  const rk=new Set();
  ITEM_RECIPES.forEach(r=>{if(rk.has(r.key))errs.push('配方重复: '+r.key);rk.add(r.key)});
  JOB_RECIPES.forEach(r=>{if(rk.has(r.key))errs.push('配方冲突(同组合已被占用): '+r.key+' → '+r.job);rk.add(r.key)});
  Object.keys(EASTER_EGGS).forEach(k=>{if(rk.has(k))errs.push('彩蛋组合与配方冲突: '+k)});
  ROOMS.forEach(r=>{
    if(r.unlockAt>0&&!r.unlockText)errs.push(`房间 ${r.id} 有解锁条件但缺少 unlockText`);
    if(!r.scene)errs.push(`提示: 房间 ${r.id} 未指定 scene 主题（可用 plain）`);
  });
  if(D.mapLayout){
    const mids=D.mapLayout.flat();
    mids.forEach(id=>{if(!roomIds.has(id))errs.push('mapLayout 引用了不存在的房间: '+id)});
    ROOMS.forEach(r=>{if(!mids.includes(r.id))errs.push('mapLayout 缺少房间: '+r.id)});
  }
  return errs;
}
function showValidation(){
  const errs=validateData();
  const ov=document.getElementById('resultOverlay'),card=document.getElementById('resultCard');
  card.innerHTML=`<div class="p-emoji">${errs.length?'⚠️':'✅'}</div><div class="p-title">数据校验</div><div class="p-desc" style="text-align:left;max-height:50vh;overflow-y:auto">${errs.length?errs.map(e=>'· '+e).join('<br>'):'全部通过：'+ROOMS.length+'个房间 / '+BASE_ITEMS.length+'个基础道具 / '+ITEM_RECIPES.length+'个物品配方 / '+JOB_RECIPES.length+'个岗位 / '+Object.keys(EASTER_EGGS).length+'个彩蛋'}</div><button onclick="closeOv()">知道了</button>`;
  ov.classList.add('show');
}


// ==================== RECIPE ADD / DELETE (edit mode) ====================
function deleteRecipe(type,key){
  if(type==='synth'){
    const r=ITEM_RECIPES.find(x=>x.key===key);if(!r)return;
    const deps=[...ITEM_RECIPES.filter(x=>x!==r&&(x.a===r.result||x.b===r.result)),
                ...JOB_RECIPES.filter(x=>x.a===r.result||x.b===r.result)];
    if(deps.length){showToast('⚠️ 先删依赖['+r.name+']的: '+deps.slice(0,3).map(d=>d.name||d.job).join('、')+(deps.length>3?' 等'+deps.length+'条':''),'warn');return}
    if(!confirm('删除物品配方 ['+r.name+'] ？'))return;
    ITEM_RECIPES.splice(ITEM_RECIPES.indexOf(r),1);
  }else{
    const r=JOB_RECIPES.find(x=>x.key===key);if(!r)return;
    if(!confirm('删除岗位 ['+r.job+'] ？'))return;
    JOB_RECIPES.splice(JOB_RECIPES.indexOf(r),1);
  }
  rebuildDerived();renderCodex();renderRoom();showToast('已删除，记得点"导出数据"保存');
}
function openRecipeForm(){
  const opts=ALL_ITEMS.map(i=>`<option value="${i.id}">${i.emoji?i.emoji+' ':''}${i.name}${i.isSynth?'(合成)':''}</option>`).join('');
  const rooms=ROOMS.map(r=>`<option value="${r.id}">${r.emoji} ${r.name}</option>`).join('');
  const card=document.getElementById('recipeCard');
  card.innerHTML=`<div class="p-title">➕ 添加公式</div>
  <div class="rf-row"><label>类型</label><select id="rfType" onchange="rfToggle()"><option value="synth">物品配方（合成新道具）</option><option value="job">岗位配方（合成岗位）</option></select></div>
  <div class="rf-row"><label>材料A</label><select id="rfA">${opts}</select></div>
  <div class="rf-row"><label>材料B</label><select id="rfB">${opts}</select></div>
  <div id="rfSynth">
    <div class="rf-row"><label>新物品id</label><input id="rfId" placeholder="英文唯一，如 redbull"></div>
    <div class="rf-row"><label>emoji</label><input id="rfEmoji" placeholder="🧃"></div>
    <div class="rf-row"><label>名称</label><input id="rfName" placeholder="如 红牛"></div>
    <div class="rf-row"><label>所在房间</label><select id="rfRoom">${rooms}</select></div>
  </div>
  <div id="rfJob" style="display:none">
    <div class="rf-row"><label>岗位名</label><input id="rfJobName" placeholder="如 卷王"></div>
    <div class="rf-row"><label>emoji</label><input id="rfJobEmoji" placeholder="🐮"></div>
  </div>
  <div class="rf-row"><label>描述</label><input id="rfDesc" placeholder="合成成功后的介绍文案"></div>
  <div style="margin-top:14px;text-align:center"><button onclick="submitRecipe()">添加</button> <button style="background:#334155" onclick="document.getElementById('recipeOverlay').classList.remove('show')">取消</button></div>`;
  document.getElementById('recipeOverlay').classList.add('show');
}
function rfToggle(){
  const t=document.getElementById('rfType').value;
  document.getElementById('rfSynth').style.display=t==='synth'?'':'none';
  document.getElementById('rfJob').style.display=t==='job'?'':'none';
}
function submitRecipe(){
  const t=document.getElementById('rfType').value;
  const a=document.getElementById('rfA').value,b=document.getElementById('rfB').value;
  if(a===b){showToast('⚠️ 两个材料不能相同','warn');return}
  const key=[a,b].sort().join('+');
  if(itemRecipeLookup[key]||jobRecipeLookup[key]){showToast('⚠️ 该组合已被其他公式占用','warn');return}
  if(EASTER_EGGS[key]){showToast('⚠️ 该组合是彩蛋，请先在 data.js 删除','warn');return}
  const desc=document.getElementById('rfDesc').value.trim();
  if(t==='synth'){
    const id=document.getElementById('rfId').value.trim();
    const emoji=document.getElementById('rfEmoji').value.trim()||'❔';
    const name=document.getElementById('rfName').value.trim();
    if(!id||!name){showToast('⚠️ 物品id和名称必填','warn');return}
    if(!/^[a-zA-Z][a-zA-Z0-9_]*$/.test(id)){showToast('⚠️ id须为英文字母/数字/下划线','warn');return}
    if(itemMap[id]){showToast('⚠️ id已存在: '+id,'warn');return}
    ITEM_RECIPES.push({a,b,result:id,emoji,name,desc:desc||name,room:document.getElementById('rfRoom').value,x:42,y:45});
  }else{
    const job=document.getElementById('rfJobName').value.trim();
    const emoji=document.getElementById('rfJobEmoji').value.trim()||'❔';
    if(!job){showToast('⚠️ 岗位名必填','warn');return}
    JOB_RECIPES.push({a,b,job,emoji,desc:desc||job});
  }
  rebuildDerived();renderCodex();renderRoom();
  document.getElementById('recipeOverlay').classList.remove('show');
  showToast('✅ 已添加'+(t==='synth'?'，新道具已放在房间中间，可拖动摆位':'')+'，记得导出数据');
}

// ==================== IMAGE UPLOAD (edit mode) ====================
let _upTarget=null;
function pickImage(path,label,max){
  _upTarget={path,label,max:max||256};
  document.getElementById('upInput').click();
}
function toPng(file,max){
  return new Promise((ok,err)=>{
    const img=new Image();
    img.onload=()=>{
      const m=Math.max(img.width,img.height)||1;
      const sc=Math.min(1,max/m);
      const w=Math.max(1,Math.round(img.width*sc)),h=Math.max(1,Math.round(img.height*sc));
      const c=document.createElement('canvas');c.width=w;c.height=h;
      c.getContext('2d').drawImage(img,0,0,w,h);
      URL.revokeObjectURL(img.src);
      c.toBlob(b=>b?ok(b):err(new Error('转码失败')),'image/png');
    };
    img.onerror=()=>{URL.revokeObjectURL(img.src);err(new Error('无法读取图片'))};
    img.src=URL.createObjectURL(file);
  });
}
async function _doUpload(file){
  if(!_upTarget)return;
  const {path,label,max}=_upTarget;_upTarget=null;
  try{
    const png=await toPng(file,max);
    const res=await fetch('upload?path='+encodeURIComponent(path),{method:'POST',body:png});
    if(!res.ok)throw new Error('HTTP '+res.status);
    USE_IMG=true;D.useImages=true;_imgVer++;localStorage.setItem('jc_imgver',_imgVer);
    IMG_OK[path]=true; // 上传成功，立即标记有图
    renderRoom();renderSlots();renderCodex();
    showToast('✅ 已上传 '+label);
  }catch(e){
    showToast('⚠️ 上传失败：请用 python3 devserver.py 启动本地服务器','warn');
  }
}

// 场景保持 1:1.2 竖向比例：优先撑满宽，超高则按高度反推宽
function fitScene(){
  const c=document.querySelector('.room-container'),s=document.getElementById('roomScene');
  if(!c||!s)return;
  let w=c.clientWidth,h=Math.round(w*1.2);
  if(h>c.clientHeight){h=c.clientHeight;w=Math.round(h/1.2)}
  s.style.width=w+'px';s.style.height=h+'px';
  // 布局为「标签 -5px- 主图 -5px- 工作区」紧凑堆叠：容器高度贴合场景图，剩余空间全部留给顶部
  c.style.flex='none';c.style.height=h+'px';
}

// 场景滑动切换房间已禁用（和双指缩放/平移手势冲突），换房间用左右箭头
document.addEventListener('keydown',e=>{if(e.key==='ArrowLeft')prevRoom();if(e.key==='ArrowRight')nextRoom()});
// 桌面端：锁定 480×980 手机比例框，整体等比缩放适配窗口；手机端保持 100dvh 自适应
function fitFrame(){
  const b=document.body;
  // 先解除 fitScene 钉住的容器高度，才能量到窗口变化后的最新可用空间
  const rc=document.querySelector('.room-container');
  if(rc){rc.style.flex='';rc.style.height=''}
  // 所有设备统一：480×980 机身等比缩放到屏幕内（手机也是缩整机，不再是流式布局）
  const W=480,H=980;
  const s=Math.min(window.innerWidth*0.94/W,window.innerHeight*0.94/H,EDIT?1.5:1.15);
  b.style.transform=`scale(${s})`;
  b.style.left=Math.max(0,(window.innerWidth-W*s)/2)+'px';
  b.style.top=Math.max(0,(window.innerHeight-H*s)/2)+'px';
  fitScene();
}
window.addEventListener('resize',fitFrame);

// ==================== BGM（欢快木吉他小曲 assets/bgm.mp3，循环播放；08-14 起替代 WebAudio 芯片音乐） ====================
const BGM={
  on:localStorage.getItem('jc_bgm_on')==='1', // 默认关闭，只有明确开过（'1'）才开
  vol:+(localStorage.getItem('jc_bgm_vol')||50),
  audio:null,
  start(){
    if(!this.audio){this.audio=new Audio(assetURL('bgm.mp3'));this.audio.loop=true}
    this.audio.volume=this.vol/100;
    this.audio.play().catch(()=>{}); // 自动播放限制下静默失败，首次点击页面的 pointerdown 会再试
  },
  stop(){if(this.audio)this.audio.pause()}
};
function updateBgmUi(){
  document.getElementById('bgmToggle').classList.toggle('on',BGM.on); // 开关滑块移到对应位置
  document.getElementById('bgmVol').value=BGM.vol;
}
function toggleBgm(){
  BGM.on=!BGM.on;
  localStorage.setItem('jc_bgm_on',BGM.on?'1':'0');
  if(BGM.on)BGM.start();else BGM.stop();
  updateBgmUi();
}
function setBgmVol(v){
  BGM.vol=+v;
  localStorage.setItem('jc_bgm_vol',v);
  if(BGM.audio)BGM.audio.volume=BGM.vol/100;
}
function openSettings(){updateBgmUi();document.getElementById('settingsOverlay').classList.add('show')}
function resetAll(){
  if(confirm('确定要清空所有游戏数据并重新开始吗？\n（已合成的岗位、图鉴进度都会丢失，此操作不可恢复）')){
    localStorage.clear();location.reload();
  }
}
// 浏览器自动播放限制：若 BGM 为开，首次点击页面时启动
document.addEventListener('pointerdown',()=>{if(BGM.on&&(!BGM.audio||BGM.audio.paused))BGM.start()});

// ==================== 顶部入职滚动条 ====================
// 姓氏表（JSON，本地内置不联网）：普通岗位 → 小X；CEO 级岗位 → X总
const SURNAMES=["王","李","张","刘","陈","杨","赵","黄","周","吴","徐","孙","马","朱","胡","郭","何","林","罗","郑","梁","宋","唐","许","韩","冯","邓","曹","彭","曾"];
const EXEC_RE=/^(CEO|CFO|COO|CTO|CHO|CIO|CMO|CPO)$|总裁|董事长/;
function tickerMsgs(){
  return JOB_RECIPES.filter(r=>S.discoveredJobs.includes(r.key)).map(r=>{
    const sur=SURNAMES[Math.floor(Math.random()*SURNAMES.length)];
    const who=EXEC_RE.test(r.job)?sur+'总':'小'+sur;
    return '🎉 恭喜 '+r.job+' '+who+' 入职，让我们欢迎新同事！👏';
  });
}
let _tickIdx=0;
function tickShow(){
  const span=document.getElementById('tickerText');
  if(!span)return;
  const list=tickerMsgs();
  const msg=list.length?list[_tickIdx++%list.length]:'✨ 工位虚位以待，快去合成第一个岗位吧！';
  span.style.animation='none';
  span.textContent=msg;
  void span.offsetWidth; // 强制重排，让新文案从头开始滚
  span.style.animation='';
  span.style.animationDuration=Math.max(6,span.scrollWidth/50)+'s';
}
function initTicker(){
  const span=document.getElementById('tickerText');
  if(!span)return;
  span.addEventListener('animationiteration',tickShow);
  tickShow();
}

// ==================== 分享海报 ====================
async function sharePoster(){
  // 从设置里点分享时先关掉设置弹窗，避免海报被压在设置下面（z-index 相同，DOM 顺序兜底也做了）
  document.getElementById('settingsOverlay').classList.remove('show');
  try{NET.track('share')}catch(e){}
  // 拉全服分位：我超过百分之多少的玩家（08-15 定稿，排行榜不做独立页，只在分享海报体现）。
  // 网络失败静默降级为普通文案，不挡海报生成。
  let pctLine='你也来试试吧！';
  try{
    const mine=jobCount();
    if(mine>0){
      const cnt=async p=>{const r=await NET.req(p,{method:'HEAD',headers:{Prefer:'count=exact'}});return +(((r.headers.get('content-range'))||'*/0').split('/')[1]||0)};
      const [below,total]=await Promise.all([cnt('players?select=id&job_count=lt.'+mine),cnt('players?select=id')]);
      if(total>0)pctLine='已超过全服 '+Math.max(1,Math.floor(below/total*100))+'% 的打工人！';
    }
  }catch(e){}
  const W=640,H=1024;
  const cv=document.createElement('canvas');cv.width=W;cv.height=H;
  const cx=cv.getContext('2d');
  const img=new Image();
  img.onload=()=>{
    const s=Math.max(W/img.width,H/img.height);
    cx.drawImage(img,(W-img.width*s)/2,(H-img.height*s)/2,img.width*s,img.height*s);
    cx.fillStyle='rgba(247,239,220,.95)';cx.fillRect(0,H-340,W,340);
    cx.fillStyle='#8a6d3b';cx.fillRect(0,H-340,W,4);
    cx.fillStyle='#5c4423';cx.textAlign='center';
    cx.font='bold 46px "Fusion Pixel","PingFang SC","Microsoft YaHei",sans-serif';
    cx.fillText('工位炼金师',W/2,H-266);
    cx.font='28px "Fusion Pixel","PingFang SC","Microsoft YaHei",sans-serif';
    cx.fillText('我在工位炼金师中解锁了 '+jobCount()+' 个岗位',W/2,H-208);
    cx.fillText(pctLine,W/2,H-168);
    const finish=()=>{
      document.getElementById('posterBox').innerHTML='<img src="'+cv.toDataURL('image/png')+'" style="width:100%;border:2px solid #8a6d3b" alt="分享海报">';
      document.getElementById('posterOverlay').classList.add('show');
    };
    try{
      const qr=qrcode(0,'M');
      qr.addData('https://realzjr.github.io/job-alchemist/'); // 固定指向线上地址，本地/打包版生成的海报扫码也能进游戏
      qr.make();
      const qi=new Image();
      qi.onload=()=>{cx.drawImage(qi,W/2-58,H-146,116,116);finish()};
      qi.onerror=finish;
      qi.src=qr.createDataURL(4,1);
    }catch(e){finish()}
  };
  img.onerror=()=>showToast('海报背景加载失败，请稍后再试');
  img.src=assetURL('rooms/front_bg.webp');
}

// ==================== 喜欢作者 ====================
// 「我做好准备投简历了！」→ 跳转投递地图（新标签页打开，保留游戏进度）
function goApply(){window.open('https://map.go2ready.com/','_blank')}
// 「获取帮助」：展开作者名片（先关设置弹窗，避免 overlay 叠层互压——海报弹窗踩过同款坑）
function showHelp(){
  document.getElementById('settingsOverlay').classList.remove('show');
  const ov=document.getElementById('resultOverlay'),card=document.getElementById('resultCard');
  card.innerHTML=`<div class="p-title">获取帮助</div><img src="${assetURL('decor/名片.webp')}" style="max-width:100%;max-height:62vh;object-fit:contain;border-radius:8px;margin:6px auto;display:block" draggable="false"><div style="text-align:center"><button onclick="closeOv()">关闭</button></div>`;
  ov.classList.add('show');
}
async function likeAuthor(){
  document.getElementById('settingsOverlay').classList.remove('show'); // 防 overlay 叠压
  // 弹花动画：本地即时反馈，不等网络
  const d=document.createElement('div');
  d.className='like-flower';
  d.innerHTML='🌹<div style="font-size:.18em;letter-spacing:3px;color:#5c4423;margin-top:10px">谢谢你的喜欢！</div>';
  document.body.appendChild(d);
  requestAnimationFrame(()=>d.classList.add('go'));
  setTimeout(()=>d.classList.add('out'),1400);
  setTimeout(()=>d.remove(),2000);
  // 全服计数：只记点击数，不限人数/次数，每点一次 +1
  const ov=document.getElementById('resultOverlay'),card=document.getElementById('resultCard');
  card.innerHTML='<div class="p-title">🌸 喜欢作者</div><div class="p-desc">统计中…</div>';
  ov.classList.add('show');
  try{
    const r=await NET.req('rpc/bump_like',{method:'POST',body:'{}'}); // 原子 +1，返回新值
    const n=await r.json();
    NET.track('like');
    card.innerHTML=`<div class="p-emoji">🌸</div><div class="p-title">谢谢喜欢！</div><div class="p-desc">已经收到 <b>${n}</b> 次喜欢啦</div><button onclick="closeOv()">关闭</button>`;
  }catch(e){
    card.innerHTML='<div class="p-emoji">🌸</div><div class="p-title">谢谢喜欢！</div><div class="p-desc">网络不佳，心意先记在本地啦</div><button onclick="closeOv()">关闭</button>';
  }
}

// ==================== 场景缩放/拖动（手机屏幕小，放大找物品） ====================
// 缩放只用角落的 ＋/－ 按钮（1~4 倍，以场景中心为锚）；放大后单指拖动平移，严格不许拉出边框。
// 变换打在内层 .room-zoom 上（transform-origin:0 0），.room-scene 的棕色边框固定不动；编辑模式不启用。
const ZM={z:1,tx:0,ty:0,pts:new Map()};
let _zmSuppress=false; // 拖动后抑制一次 click，避免平移误触物品
function zmScene(){return document.getElementById('roomZoom')}
function zmApply(){
  const s=zmScene();if(!s)return;
  if(ZM.z<=1.01){ZM.z=1;ZM.tx=0;ZM.ty=0;s.style.transform='';s.style.transition='';return}
  s.style.transition='none';
  s.style.transform=`translate(${ZM.tx}px,${ZM.ty}px) scale(${ZM.z})`;
}
// 严格界限：translate(t) scale(z) 且 origin 0 0 时，内容覆盖整个框 ⟺ t∈[W(1-z),0]
function zmClamp(){
  const s=zmScene();if(!s)return;
  const W=s.offsetWidth,H=s.offsetHeight;
  ZM.tx=Math.min(0,Math.max(W*(1-ZM.z),ZM.tx));
  ZM.ty=Math.min(0,Math.max(H*(1-ZM.z),ZM.ty));
}
function zmTo(z2,anchor){
  z2=Math.min(4,Math.max(1,z2));
  const k=z2/ZM.z;
  ZM.tx=anchor.x-(anchor.x-ZM.tx)*k;
  ZM.ty=anchor.y-(anchor.y-ZM.ty)*k;
  ZM.z=z2;zmClamp();zmApply();
}
// 角落缩放按钮：以场景中心为锚点步进
function zmStep(k){
  const s=zmScene();if(!s)return;
  zmTo(ZM.z*k,{x:s.offsetWidth/2,y:s.offsetHeight/2});
}
function zoomReset(){
  ZM.z=1;ZM.tx=0;ZM.ty=0;ZM.pts.clear();
  const s=zmScene();if(s){s.style.transform='';s.style.transition=''}
}
function initZoom(){
  const c=document.getElementById('roomContainer');
  if(!c)return;
  c.addEventListener('pointerdown',e=>{
    if(editing()||e.target.closest('.zoom-btn'))return;
    ZM.pts.set(e.pointerId,{x:e.clientX,y:e.clientY});
  });
  c.addEventListener('pointermove',e=>{
    if(editing()||e.target.closest('.zoom-btn')||!ZM.pts.has(e.pointerId))return;
    const prev=ZM.pts.get(e.pointerId);
    ZM.pts.set(e.pointerId,{x:e.clientX,y:e.clientY});
    if(ZM.pts.size===1&&ZM.z>1){ // 只有放大后才允许拖动平移
      const dx=e.clientX-prev.x,dy=e.clientY-prev.y;
      if(Math.abs(dx)+Math.abs(dy)>3)_zmSuppress=true;
      ZM.tx+=dx;ZM.ty+=dy;zmClamp();zmApply();
    }
  });
  const up=e=>{ZM.pts.delete(e.pointerId)};
  c.addEventListener('pointerup',up);
  c.addEventListener('pointercancel',up);
  c.addEventListener('click',e=>{
    if(_zmSuppress){e.stopPropagation();e.preventDefault();_zmSuppress=false}
  },true);
}

// ==================== 新手教程（首次进入触发，老板带教） ====================
// 流程：开场白 → 点开 快递/招财猫/咸鱼 → 假装「猫喂鱼」合成失败 → 被迫点提示
//       → 按提示合成前台 → 打开图鉴 → 结束语。头像先用老板立绘占位，后续换正式引导员。
const TUT={active:false,step:0,rev:[]}; // rev=教程独立场景内的揭示显示状态（与存档 S.revealed 解耦）
const TUT_ITEMS=['快递','招财猫','咸鱼']; // 教程要揭开的三个物品（前台配方+猫鱼整蛊）
const TUT_SPOTS={'快递':{x:20,y:62,w:64},'招财猫':{x:45,y:36,w:60},'咸鱼':{x:68,y:68,w:56}}; // 训练场固定摆位（%）
// 教程文案：权威源是 剧情/教程.txt（gen_data.py 写进 data.js 的 tutTexts）；下面是 data.js 缺该字段时的兜底
const TUT_FALLBACK=[
 '哟，新面孔？我是你的教官。第一天上班，看谁都是陌生人吧？告诉你这栋楼的秘密——万物皆有灵性，两样小东西凑一块儿，就能"砰"地碰出一位同事。想认识大家？跟我学炼金。',
 '看到房间里的 ❓ 没？都是沉睡着的办公用品，等着你唤醒。先把「快递」「招财猫」「咸鱼」三个点醒，咱们从它们开始。',
 '先摸摸炼金的脾气：选中「招财猫」和「咸鱼」，点【合成！】——给猫喂条鱼，看看会碰出什么。',
 '噗……太咸的东西给猫吃不好，炼金炉都委屈得冒烟了。卡壳别硬猜，点右边【💡提示】，我给你透个天机。',
 '天机已泄露：「快递」+「招财猫」。选中它俩，点【合成！】——砰！你的第一位同事就要现身。',
 '🎉 前台入职！看见没，物品有灵，同事就是这么"炼"出来的。点右边【📖图鉴】，看看你的人才版图。',
 '图鉴里藏着所有物品、岗位和彩蛋的线索；【🗺️地图】能带你去更深的楼层——认识的同事越多，能去的楼层越多。去吧，把整栋楼的同事都"炼"出来，我看好你！',
];
const TT=(D.tutTexts&&D.tutTexts.length>=7)?D.tutTexts:TUT_FALLBACK;
const TUT_STEPS=[
 {text:TT[0],narrate:true},
 {text:TT[1],
  targets(){const id=TUT_ITEMS.find(i=>!TUT.rev.includes(i));const el=id&&document.querySelector(`.item-card[data-id="${id}"]`);return el?[el]:[]},
  on:'reveal',done:()=>TUT_ITEMS.every(i=>TUT.rev.includes(i)),skipIfDone:true},
 {text:TT[2],
  targets(){return ['招财猫','咸鱼'].map(i=>document.querySelector(`.item-card[data-id="${i}"]`)).concat([document.getElementById('craftBtn')]).filter(Boolean)},
  // 手势驻留：指第一个还没进槽的物品，两个都选好才指合成钮——玩家没完成对应操作，手势不动
  finger(){const nx=['招财猫','咸鱼'].find(i=>!S.slots.includes(i));return nx?document.querySelector(`.item-card[data-id="${nx}"]`):document.getElementById('craftBtn')},
  on:'craft',done:d=>d.kind==='fail'&&d.key===['招财猫','咸鱼'].sort().join('+')},
 {text:TT[3],
  targets(){const b=document.querySelectorAll('.side-btn')[0];return b?[b]:[]},
  on:'hint',done:()=>true},
 {text:TT[4],
  targets(){return ['快递','招财猫'].map(i=>document.querySelector(`.item-card[data-id="${i}"]`)).concat([document.getElementById('craftBtn')]).filter(Boolean)},
  finger(){const nx=['快递','招财猫'].find(i=>!S.slots.includes(i));return nx?document.querySelector(`.item-card[data-id="${nx}"]`):document.getElementById('craftBtn')},
  on:'craft',done:d=>d.kind==='job'&&d.job==='前台'},
 {text:TT[5],
  targets(){const b=document.querySelectorAll('.side-btn')[1];return b?[b]:[]},
  on:'codex',done:()=>true},
 {text:TT[6],narrate:true,last:true},
];
function tutEls(){const st=TUT_STEPS[TUT.step];return(TUT.active&&st&&st.targets)?st.targets():[]}
function showTutBox(){const l=document.getElementById('tutLayer');if(!l)return;l.querySelector('.tut-box').classList.remove('hid');const p=l.querySelector('.tut-peek');if(p)p.classList.remove('on')}
function hideTutBox(){const l=document.getElementById('tutLayer');if(!l||!TUT.active)return;l.querySelector('.tut-box').classList.add('hid');const p=l.querySelector('.tut-peek');if(p)p.classList.add('on')}
function tutRender(){
  const layer=document.getElementById('tutLayer');if(!layer||!TUT.active)return;
  // 已完成条件的步直接跳过（仅限检查存量状态的步，如揭示物品；事件驱动的步不能跳）
  let st=TUT_STEPS[TUT.step];
  while(st&&st.skipIfDone&&st.done&&st.done({})){TUT.step++;st=TUT_STEPS[TUT.step]}
  if(!st){tutEnd();return}
  document.querySelectorAll('.tut-spot').forEach(el=>el.classList.remove('tut-spot'));
  tutEls().forEach(el=>el.classList.add('tut-spot'));
  tutFinger();
  const box=layer.querySelector('.tut-box');
  box.querySelector('.tut-text').textContent=st.text;
  box.classList.toggle('narrate',!!st.narrate);
  // 只在「换步」时弹回对话框——同一步内 renderRoom 重绘不能把玩家已收起的对话框又弹出来；
  // 收起只能靠玩家点击（点对话框/点目标物），不做定时自动收起
  const stepChanged=TUT.renderedStep!==TUT.step;
  TUT.renderedStep=TUT.step;
  if(stepChanged){
    showTutBox();
    const nx=box.querySelector('.tut-next');
    nx.style.display='';
    nx.textContent=st.narrate?'▼ 点击继续':'▼ 点我收起，照做就行';
  }
}
// 👆 手势定位到当前目标正中；有 finger() 的步按操作进度驻留（没完成对应操作就不动），其余指第一个目标
function tutFinger(){
  const layer=document.getElementById('tutLayer');const f=layer&&layer.querySelector('.tut-finger');if(!f)return;
  const st=TUT.active?TUT_STEPS[TUT.step]:null;
  const el=st?(st.finger?st.finger():(st.targets?st.targets()[0]:null)):null;
  if(!el){f.style.display='none';return}
  const r=el.getBoundingClientRect(),br=document.body.getBoundingClientRect(),sc=br.width/480;
  f.style.display='';
  const fw=f.offsetWidth||30,fh=f.offsetHeight||30;
  f.style.left=((r.left+r.width/2-br.left)/sc-fw/2)+'px';
  f.style.top=((r.top+r.height/2-br.top)/sc-fh/2)+'px';
}
function tutStart(){
  if(TUT.active)return;TUT.active=true;TUT.step=0;TUT.renderedStep=-1;TUT.rev=[];
  // 独立场景前的清场：槽位清空（防老玩家残留物品干扰教程配方）、缩放复位、隐藏主导航（body.tut-on）
  S.slots=[null,null];renderSlots();
  document.body.classList.add('tut-on');
  if(typeof zoomReset==='function')zoomReset();
  let layer=document.getElementById('tutLayer');
  if(!layer){
    layer=document.createElement('div');layer.id='tutLayer';
    // 手势图片 assets/decor/手势.webp（用户上传后打包自动内联），没图时用 👆 emoji 兜底
    layer.innerHTML=`<div class="tut-finger"><img src="${assetURL('decor/手势.webp')}" onerror="this.outerHTML='👆'" draggable="false"></div><div class="tut-box"><div class="tut-avatar"><img src="${assetURL('decor/教官.webp')}" onerror="this.outerHTML='👔'"></div><div class="tut-body"><div class="tut-name">教官</div><div class="tut-text"></div><div class="tut-next">▼ 点击继续</div></div><div class="tut-skip" onclick="event.stopPropagation();tutEnd()">跳过教程</div></div><div class="tut-peek" onclick="event.stopPropagation();showTutBox()">💬</div>`;
    document.body.appendChild(layer);
    layer.querySelector('.tut-box').addEventListener('click',()=>{
      const st=TUT_STEPS[TUT.step];
      if(!TUT.active||!st)return;
      if(st.narrate){st.last?tutEnd():(TUT.step++,tutRender())}
      else hideTutBox(); // 动手的步：点对话框收起，免得挡住目标
    });
  }
  layer.classList.add('on');
  renderRoom(); // 渲染独立训练场（renderRoom 里 TUT.active 分支，与真实房间无关）
  tutRender();
}
function tutEnd(){TUT.active=false;TUT.rev=[];
  document.body.classList.remove('tut-on');
  if(!S.tutorialDone)NET.track('tutorial_done');
  S.tutorialDone=true;save();document.querySelectorAll('.tut-spot').forEach(el=>el.classList.remove('tut-spot'));const l=document.getElementById('tutLayer');if(l)l.classList.remove('on');renderRoom()}
function tutNotify(evt,data){
  if(!TUT.active)return;
  const st=TUT_STEPS[TUT.step];
  if(st&&st.on===evt&&(!st.done||st.done(data||{}))){TUT.step++;if(TUT.step>=TUT_STEPS.length){tutEnd();return}}
  tutRender();
}
// 教程期间的点击守卫：只放行高亮目标、弹窗内容和教程对话框，其余一律拦截；点到目标时顺手收起对话框
['pointerdown','click'].forEach(t=>document.addEventListener(t,e=>{
  if(!TUT.active)return;
  if(e.target.closest('.overlay')||e.target.closest('.tut-box')||e.target.closest('.tut-peek'))return;
  if(tutEls().some(el=>el===e.target||el.contains(e.target))){if(t==='pointerdown')hideTutBox();return}
  e.preventDefault();e.stopPropagation();e.stopImmediatePropagation();
},true));
window.addEventListener('resize',()=>{if(TUT.active)tutRender()});
function maybeTutorial(){
  if(EDIT||PREVIEW)return;
  if(location.search.includes('admin=1')){setTimeout(adminStats,800);return} // 隐藏统计页不走教程
  const fresh=!S.revealed.length&&!S.discoveredItems.length&&!S.discoveredJobs.length;
  if(location.search.includes('tut=1')||(fresh&&!S.tutorialDone))setTimeout(tutStart,400);
}
// 设置里的「重看教程」：已有进度也能复盘（揭示步会自动跳过已完成的）
function replayTutorial(){document.getElementById('settingsOverlay').classList.remove('show');S.tutorialDone=false;tutStart()}

// ==================== 后端（Supabase：排行榜/喜欢计数/玩家统计） ====================
// 无登录轻量后端：玩家 = localStorage 里的随机 id；所有请求失败静默，绝不影响游戏本体。
// 表结构见项目根 supabase_setup.sql（在 Supabase SQL Editor 里执行一次即可）
const SB_URL='https://aefdlbdtxzdyyufsrhmf.supabase.co';
const SB_KEY='eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImFlZmRsYmR0eHpkeXl1ZnNyaG1mIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODY2ODYyODUsImV4cCI6MjEwMjI2MjI4NX0._wot7eWVoRJhL0vxdZyKPfYOcZZfr72Je2rewmcl5CE';
const NET={
  pid:localStorage.getItem('jc_pid'),
  nick:localStorage.getItem('jc_nick')||'',
  _t:null,
  init(){
    if(!this.pid){this.pid='p'+Math.random().toString(36).slice(2,10)+Date.now().toString(36).slice(-4);localStorage.setItem('jc_pid',this.pid)}
    this.track('visit');
    this.syncSoon();
  },
  req(path,opt){
    opt=opt||{};
    opt.headers=Object.assign({'apikey':SB_KEY,'Authorization':'Bearer '+SB_KEY,'Content-Type':'application/json'},opt.headers||{});
    return fetch(SB_URL+'/rest/v1/'+path,opt);
  },
  track(ev,meta){ // 行为事件，fire-and-forget
    if(!this.pid)return;
    this.req('events',{method:'POST',body:JSON.stringify({player_id:this.pid,event:ev,meta:meta||null})}).catch(()=>{});
  },
  syncSoon(){clearTimeout(this._t);this._t=setTimeout(()=>this.sync(),1500)}, // save() 每次都会调，防抖合并
  sync(){ // 成绩快照 upsert（排行榜数据源）
    if(!this.pid)return;
    this.req('players',{method:'POST',headers:{Prefer:'resolution=merge-duplicates'},body:JSON.stringify({
      id:this.pid,nickname:this.nick,job_count:S.discoveredJobs.length,item_count:S.revealed.length,tutorial_done:!!S.tutorialDone
    })}).catch(()=>{});
  }
};

// 📊 隐藏统计页（?admin=1）：玩家数/教程完成率/解锁分布/喜欢数/最近事件
async function adminStats(){
  const ov=document.getElementById('resultOverlay'),card=document.getElementById('resultCard');
  card.innerHTML='<div class="p-title">📊 玩家统计</div><div class="p-desc">加载中…</div>';
  ov.classList.add('show');
  try{
    const cnt=async p=>{const r=await NET.req(p,{method:'HEAD',headers:{Prefer:'count=exact'}});return +(((r.headers.get('content-range'))||'*/0').split('/')[1]||0)};
    const [total,tutDone,jobsR,likesR,evR]=await Promise.all([
      cnt('players?select=id'),
      cnt('players?select=id&tutorial_done=eq.true'),
      NET.req('players?select=job_count&job_count=gt.0&limit=1000'),
      NET.req('likes?select=count&id=eq.1'),
      NET.req('events?select=event,created_at&order=created_at.desc&limit=12')
    ]);
    const jobs=(await jobsR.json()).map(r=>r.job_count);
    const avg=jobs.length?(jobs.reduce((a,b)=>a+b,0)/jobs.length).toFixed(1):'0';
    const likes=(await likesR.json())[0];
    const evs=(await evR.json()).map(e=>`<div style="display:flex;justify-content:space-between;padding:2px 6px;border-bottom:1px dashed #d8c8a2"><span>${e.event}</span><span>${(e.created_at||'').slice(5,16).replace('T',' ')}</span></div>`).join('');
    card.innerHTML=`<div class="p-title">📊 玩家统计</div><div style="text-align:left;font-size:.95em;line-height:2">
      累计访问玩家：<b>${total}</b><br>教程完成：<b>${tutDone}</b>（${total?Math.round(tutDone/total*100):0}%）<br>
      上榜玩家（≥1岗）：<b>${jobs.length}</b>　人均解锁 <b>${avg}</b> 岗　最多 <b>${jobs.length?Math.max(...jobs):0}</b> 岗<br>
      🌸 喜欢作者：<b>${likes?likes.count:0}</b></div>
      <div class="p-desc" style="margin-top:6px">最近事件</div>
      <div style="text-align:left;max-height:28vh;overflow-y:auto;font-size:.85em">${evs||'暂无'}</div>
      <button onclick="closeOv()">关闭</button>`;
  }catch(e){
    card.innerHTML='<div class="p-title">📊 玩家统计</div><div class="p-desc">加载失败（网络或权限）</div><button onclick="closeOv()">关闭</button>';
  }
}

// ==================== INIT ====================
function hideLoading(){
  if(window._ldTimer){clearInterval(window._ldTimer);window._ldTimer=null}
  const lo=document.getElementById('loadingOverlay');
  if(!lo)return;
  lo.classList.add('hide');
  setTimeout(()=>lo.remove(),500);
}
if(!window.GAME_DATA){
  document.body.innerHTML='<div style="padding:60px 30px;text-align:center;color:#f87171">⚠️ 未找到 data.js（GAME_DATA）<br><br><span style="color:#94a3b8;font-size:.85em">请确认 data.js 与 index.html 在同一目录</span></div>';
}else{
  load();initUnlocks();checkBossEgg();_bossInvitePending=false;
  probeImages().finally(()=>{renderRoom();renderSlots();renderCodex();hideLoading();initTicker();initZoom();NET.init();maybeTutorial()});
  if(document.fonts&&document.fonts.ready)document.fonts.ready.then(()=>fixEdgeLabels()); // 像素字体加载后标签宽度会变，重新收边一次
  fitFrame();
  if(EDIT)initEditMode();
  const _errs=validateData();
  if(_errs.length)console.warn('[数据校验] '+_errs.length+'个问题:',_errs);
  if(DEBUG||(EDIT&&_errs.length))showValidation();
}
</script>
</body>
</html>
