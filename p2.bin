// desc 三行：正经亮点 \n 反差幽默 \n 网感玩梗；card 为图鉴二级页「岗位卡片」

jobRecipes:[{"a":"钥匙","b":"门禁卡","job":"保安","emoji":"💂","desc":"守住公司第一道门\n你永远不知道什么时间不在岗\n门禁系统的肉身形态","card":{"tag":"基础服务","duties":"· 门岗值守与出入管理\n· 巡逻与安全检查\n· 突发事件处置","chain":"上游：物业、行政\n下游：全体员工、访客","salary":"4-9K","habitat":"全行业"}},{"a":"拖把","b":"钥匙","job":"保洁","emoji":"🧼","desc":"公司第一个见到清晨的人\n工位整洁，比老板画的饼干净\n办公室隐形守护者","card":{"tag":"基础服务","duties":"· 办公区域清洁维护\n· 垃圾处理与消杀\n· 耗材补充","chain":"上游：行政、物业\n下游：全体员工","salary":"4-9K","habitat":"全行业"}},{"a":"快递","b":"招财猫","job":"前台","emoji":"💁","desc":"用微笑给全公司定下基调\n公司的门面，快递的归宿\n颜值担当兼包裹中转站","card":{"tag":"行政","duties":"· 访客接待与登记\n· 快递收发与电话转接\n· 会议室协调\n· 行政支持","chain":"上游：访客、员工\n下游：行政专员","salary":"应届 5-9K｜1-3年 7-13K｜3-5年 10-18K｜5-10年 15-30K","habitat":"全行业"}},{"a":"外卖","b":"电话","job":"外卖员","emoji":"🛵","desc":"饭点的救星，饿着肚子的闪电侠\n他到了，整层楼都活了\n骑的是电动车，送的是命","card":{"tag":"基础服务","duties":"· 按单取餐与配送\n· 路线规划与时效管理\n· 异常订单沟通","chain":"上游：商家、平台调度\n下游：顾客","salary":"4-9K","habitat":"美团、淘宝闪购、京东"}},{"a":"水桶","b":"门禁卡","job":"实习生（不转正版）","emoji":"🐣","desc":"用最少的工资体验最全的职场\n不转正的实习生地位仅此总裁\n全公司性价比之王"},{"a":"快递","b":"电话","job":"快递员","emoji":"📬","desc":"风雨无阻，把包裹送到你手上\n签收的不是快递，是期待\n签收的不是快递，是期待","card":{"tag":"基础服务","duties":"· 快件收派与签收确认\n· 异常件处理\n· 片区客户关系维护","chain":"上游：分拣中心\n下游：收件人、商家","salary":"4-9K","habitat":"顺丰、京东、中通、圆通"}},{"a":"简历","b":"水杯","job":"HRBP","emoji":"🤝","desc":"业务部门的第一位人力合伙人\n业务当她外人，员工当她卧底\n夹心饼干中间那层奶油","card":{"tag":"人力资源","duties":"· 驻场支持业务部门人力工作\n· 推动绩效与人才盘点落地\n· 处理员工关系问题","chain":"上游：业务部门负责人、COE\n下游：招聘、薪酬绩效、培训","salary":"应届 6-10K｜1-3年 8-15K｜3-5年 12-25K｜5-10年 20-40K","habitat":"互联网：阿里巴巴、华为\n快消：联合利华\n新能源：宁德时代"}},{"a":"简历","b":"打印机","job":"人力专员","emoji":"🧑‍🤝‍🧑","desc":"入转调离，人事全包\n全司八卦的合法知情人\nHR界的瑞士军刀","card":{"tag":"人力资源","duties":"· 入转调离手续办理\n· 考勤与社保公积金管理\n· 员工档案维护","chain":"上游：HRBP、员工\n下游：财务、行政","salary":"应届 6-10K｜1-3年 8-15K｜3-5年 12-25K｜5-10年 20-40K","habitat":"全行业"}},{"a":"发财树","b":"公章","job":"企业文化专员","emoji":"🚩","desc":"把价值观从墙上请到人心里\n横幅一拉，文化就有了\n全司氛围组组长","card":{"tag":"人力资源","duties":"· 策划文化活动与内刊\n· 价值观传播与落地\n· 员工关怀项目","chain":"上游：CHO\n下游：全体员工","salary":"应届 6-10K｜1-3年 8-15K｜3-5年 12-25K｜5-10年 20-40K","habitat":"互联网：字节跳动、阿里巴巴\n新消费：泡泡玛特"}},{"a":"算盘","b":"锅","job":"会计","emoji":"🧑‍💼","desc":"每一分钱的来去都有据可查\n算错或算对都是你的锅\n借贷必相等，人生不相等","card":{"tag":"财务","duties":"· 日常账务处理与凭证编制\n· 月度结账与报表出具\n· 税务申报配合\n· 费用审核","chain":"上游：出纳、业务部门\n下游：财务分析、审计","salary":"应届 5-9K｜1-3年 7-14K｜3-5年 12-20K｜5-10年 18-35K","habitat":"全行业"}},{"a":"快递","b":"算盘","job":"供应链专员","emoji":"🚛","desc":"让货从工厂一路顺到仓库\n哪里堵车哪里缺货都找他\n货流的交通警察","card":{"tag":"供应链","duties":"· 采购与库存计划执行\n· 物流运输协调\n· 供应商交付跟进\n· 供应链数据分析","chain":"上游：采购、销售预测\n下游：仓储、物流商","salary":"应届 6-11K｜1-3年 9-16K｜3-5年 13-22K｜5-10年 18-35K","habitat":"电商：京东、SHEIN\n制造：比亚迪、富士康\n物流：顺丰"}},{"a":"貔貅","b":"打印机","job":"出纳","emoji":"💵","desc":"公司资金的最后一道人工闸\n过手千万，卡里四位数\n数钱数到手抽筋，都不是自己的","card":{"tag":"财务","duties":"· 资金收付与银行结算\n· 报销付款执行\n· 资金日报编制","chain":"上游：会计、审批人\n下游：银行、员工","salary":"应届 5-9K｜1-3年 7-14K｜3-5年 12-20K｜5-10年 18-35K","habitat":"全行业"}},{"a":"制冰机","b":"电话","job":"售后客服","emoji":"☎️","desc":"在投诉的废墟上重建信任\n客户的出气筒，公司的防弹衣\n道歉速度全司第一","card":{"tag":"客服","duties":"· 处理退换货与投诉\n· 安抚客户情绪并提供补偿方案\n· 反馈高频问题","chain":"上游：客服专员、用户\n下游：供应链、产品","salary":"应届 4-7K｜1-3年 5-9K｜3-5年 7-12K｜5-10年 10-18K","habitat":"电商：拼多多、阿里巴巴\n家电：美的、海尔\n物流：顺丰"}},{"a":"便签","b":"饮水机","job":"培训专员","emoji":"🎓","desc":"把普通人养成独当一面的人\n培训全场鼓掌，落地全场失忆\n知识搬运工头","card":{"tag":"人力资源","duties":"· 搭建培训体系与课程库\n· 组织新人与领导力培训\n· 评估培训效果","chain":"上游：组织发展、业务部门\n下游：全体员工","salary":"应届 6-10K｜1-3年 8-15K｜3-5年 12-25K｜5-10年 20-40K","habitat":"互联网：字节跳动、腾讯\n零售：海底捞"}},{"a":"放大镜","b":"报销单","job":"审计","emoji":"🕵️","desc":"全公司唯一靠怀疑吃饭的人\n最怕收到她邮件，没有之一\n大家治账，她治大家","card":{"tag":"财务","duties":"· 内部审计计划与执行\n· 流程合规检查\n· 舞弊调查与整改跟进","chain":"上游：董事会/审计委员会\n下游：各部门","salary":"应届 5-9K｜1-3年 7-14K｜3-5年 12-20K｜5-10年 18-35K","habitat":"会计师事务所：普华永道、安永、立信\n大型集团内审"}},{"a":"电话","b":"垃圾桶","job":"客服专员","emoji":"🎧","desc":"把客户的火气聊成好评\n亲亲这边建议您重启呢\n情绪稳定的职业选手","card":{"tag":"客服","duties":"· 在线/电话解答客户咨询\n· 工单记录与流转\n· 客户满意度回访","chain":"上游：用户\n下游：售后、产品、运营","salary":"应届 4-7K｜1-3年 5-9K｜3-5年 7-12K｜5-10年 10-18K","habitat":"电商：京东、阿里巴巴\n通信：中国移动、中国联通"}},{"a":"拖把","b":"门禁卡","job":"应届实习生","emoji":"🌱","desc":"职场第一课：复印和微笑\n眼里还有光，珍惜这个阶段\n新鲜出炉的职场小白"},{"a":"简历","b":"放大镜","job":"招聘专员","emoji":"🧲","desc":"在简历池里许愿捞到最合适的鱼\noffer的候选人已读不回，像极了爱情","card":{"tag":"人力资源","duties":"· 发布职位与筛选简历\n· 组织面试与候选人跟进\n· 招聘渠道维护\n· 招聘数据分析","chain":"上游：用人部门、HRBP\n下游：候选人、入职团队","salary":"应届 6-10K｜1-3年 8-15K｜3-5年 12-25K｜5-10年 20-40K","habitat":"猎头：科锐国际、猎聘\n互联网：字节跳动、腾讯"}},{"a":"算盘","b":"放大镜","job":"数据分析师","emoji":"📈","desc":"让沉默的数字开口讲故事\n一百张图证明老板是对的\nExcel是她的画布","card":{"tag":"数据","duties":"· 搭建业务数据报表体系\n· 专题分析与归因诊断\n· 支持AB实验设计与复盘\n· 向业务输出决策建议","chain":"上游：数据开发、业务运营\n下游：产品经理、运营、管理层","salary":"应届 9-16K｜1-3年 13-25K｜3-5年 20-35K｜5-10年 30-50K","habitat":"互联网：字节跳动、美团\n金融：招商银行、中国平安\n零售：瑞幸"}},{"a":"公章","b":"算盘","job":"法务","emoji":"⚖️","desc":"给每个商业决定系上安全带\n平时没人理，出事全找她\n公司在法庭上的嘴替","card":{"tag":"法务/合规","duties":"· 合同起草与审核\n· 法律咨询与风险提示\n· 纠纷与诉讼处理\n· 知识产权管理","chain":"上游：业务部门\n下游：外部律所、法院","salary":"应届 7-12K｜1-3年 10-18K｜3-5年 15-30K｜5-10年 25-50K","habitat":"律所：金杜、中伦\n互联网：腾讯、字节跳动"}},{"a":"电话","b":"放大镜","job":"用户研究","emoji":"🔬","desc":"替一万个用户坐在会议室\n访谈五十人，结论早内定了\n用户嘴替，报告写手","card":{"tag":"产品","duties":"· 设计并执行访谈、问卷、可用性测试\n· 输出用户画像与洞察报告\n· 支持产品决策","chain":"上游：产品经理、运营\n下游：产品经理、设计师","salary":"应届 9-18K｜1-3年 15-25K｜3-5年 22-40K｜5-10年 35-60K","habitat":"互联网：腾讯、阿里巴巴\n咨询：尼尔森、益普索\n智能硬件：小米"}},{"a":"电话","b":"水桶","job":"电话销售","emoji":"📢","desc":"在三百次拒绝里等一次接着说\n通讯录刷完了，黑名单也满了\n被拒绝界的全勤奖","card":{"tag":"销售","duties":"· 电话开发潜在客户\n· 邀约演示或到店\n· 跟进意向客户转化","chain":"上游：销售经理\n下游：售前、客服","salary":"底薪 5-10K+提成｜1-3年 综合10-25K｜3-5年 综合20-40K｜5-10年 综合30-60K+","habitat":"在线教育：猿辅导、作业帮\n保险：中国平安、泰康"}},{"a":"报销单","b":"公章","job":"税务专员","emoji":"💸","desc":"在规则边界上为公司省钱\n合法节税，尺度比发际线难把握\n和税务局斗智斗勇的人","card":{"tag":"财务","duties":"· 纳税申报与发票管理\n· 税务筹划与政策研究\n· 税务风险应对","chain":"上游：会计\n下游：税务局、审计","salary":"应届 5-9K｜1-3年 7-14K｜3-5年 12-20K｜5-10年 18-35K","habitat":"全行业"}},{"a":"剪刀","b":"垃圾桶","job":"编辑","emoji":"📝","desc":"错别字的头号天敌\n错一字扣五十，一篇稿费四十\n红笔之下，无一幸免","card":{"tag":"内容/传媒","duties":"· 选题策划与稿件组织\n· 审校与内容质量把关\n· 作者资源维护","chain":"上游：作者、记者\n下游：排版、新媒体运营","salary":"应届 5-10K｜1-3年 8-15K｜3-5年 12-22K｜5-10年 18-30K","habitat":"出版：中信出版集团、磨铁\n媒体：财新、三联生活周刊"}},{"a":"公章","b":"精品茶叶","job":"董事会秘书","emoji":"🗝️","desc":"公司与资本间的官方发言人\n她知道的秘密，都不能说\n上市公司的门面担当","card":{"tag":"高管","duties":"· 信息披露与公告管理\n· 董事会会议组织\n· 监管与投资者沟通","chain":"上游：董事会\n下游：证监会、交易所、投资者","salary":"年薪 80-300万（含奖金期权）｜上市公司及独角兽另议","habitat":"上市公司及拟上市公司"}},{"a":"算盘","b":"节日福利","job":"薪酬绩效","emoji":"💰","desc":"用一套Excel衡量全公司价值\n全公司最想删的表出自她手\n算工资的，自己工资不算高","card":{"tag":"人力资源","duties":"· 薪酬核算与发放\n· 绩效制度设计与执行\n· 薪酬调研与对标","chain":"上游：财务、HRBP\n下游：全体员工","salary":"应届 6-10K｜1-3年 8-15K｜3-5年 12-25K｜5-10年 20-40K","habitat":"咨询：美世、韦莱韬悦\n互联网：阿里巴巴、字节跳动"}},{"a":"水杯","b":"节日福利","job":"行政专员","emoji":"🗂️","desc":"公司这台机器的无声润滑油\n公司离了她，厕纸都得自带\n隐形管家，全能打杂天花板","card":{"tag":"行政","duties":"· 办公用品与资产管理\n· 供应商对接与采购执行\n· 活动与会议支持\n· 办公环境维护","chain":"上游：各部门\n下游：供应商、物业","salary":"应届 5-9K｜1-3年 7-13K｜3-5年 10-18K｜5-10年 15-30K","habitat":"全行业"}},{"a":"发财树","b":"打印机","job":"财务分析","emoji":"📊","desc":"从报表里读出公司的未来\n数据说没救了，老板让她别说了\n报表翻译官","card":{"tag":"财务","duties":"· 经营数据分析与预算管理\n· 出具经营分析报告\n· 支持管理层决策","chain":"上游：会计、业务数据\n下游：CFO、管理层","salary":"应届 5-9K｜1-3年 7-14K｜3-5年 12-20K｜5-10年 18-35K","habitat":"互联网：美团、字节跳动\n快消：宝洁"}},{"a":"报销单","b":"锅","job":"采购","emoji":"🛍️","desc":"砍价砍到供应商拉黑\n老板看完说：还能再便宜点吗\n省钱界的冷面杀手","card":{"tag":"行政","duties":"· 供应商开发与比价谈判\n· 采购订单执行与跟进\n· 采购成本分析","chain":"上游：各部门需求\n下游：供应商、财务","salary":"应届 5-9K｜1-3年 7-13K｜3-5年 10-18K｜5-10年 15-30K","habitat":"制造：比亚迪、美的\n零售：永辉、盒马"}},{"a":"打印机","b":"报销单","job":"销售支持","emoji":"🎯","desc":"销售的弹药库和后勤部\n销售在前冲锋，她在后贴票\n订单背后的那个人","card":{"tag":"销售","duties":"· 合同、订单与资料处理\n· 销售数据统计\n· 协调发货与开票","chain":"上游：销售团队\n下游：财务、供应链","salary":"底薪 5-10K+提成｜1-3年 综合10-25K｜3-5年 综合20-40K｜5-10年 综合30-60K+","habitat":"医疗器械：迈瑞\n快消：宝洁、联合利华"}},{"a":"公章","b":"放大镜","job":"风控合规","emoji":"🚦","desc":"业务狂奔时守住那条线\n业务嫌她踩刹车，监管夸踩得好\n全司著名扫兴担当","card":{"tag":"法务/合规","duties":"· 建立合规制度与流程\n· 业务风险评估与审查\n· 监管对接